---
import { Image } from "astro:assets";
import logo from "../assets/images/logo-lockup-inverse.png";
import Icon from "./Icon.astro";
import WallLabel from "./WallLabel.astro";
import {
  contact,
  socials,
  studio,
  nav,
  markets,
  workCategories,
} from "../content/site";

import { esUi, esContact, esCategories } from "../content/site.es";
import { localeOf, esCategoryPath } from "../lib/i18n";

const year = 2026;

/**
 * The footer is NOT `transition:persist` — it re-renders on every navigation,
 * so unlike the header it can read the locale at build time and be done.
 */
const lang = localeOf(Astro.url.pathname);
const es = lang === "es";

const t = {
  label: es ? esContact.label : contact.label,
  titleLines: es ? esContact.titleLines : contact.titleLines,
  cta: es ? esUi.startProject : "Start a project",
  ctaHref: es ? "/es/contacto/" : "/contact/",
  email: es ? esContact.emailLabel : "Email",
  phone: es ? esContact.phoneLabel : "Phone",
  from: es ? esContact.fromLabel : "Working from",
  work: es ? esUi.work : "Work",
  where: es ? esUi.whereWeWork : "Where we work",
  marketingIn: es ? esUi.marketingIn : "Marketing & photography in",
  licensing: es ? esUi.imageLicensing : "Image licensing",
  years: es ? "años" : "years across",
};

/**
 * The category links follow the reader's language. A Spanish page whose footer
 * links back into the English site undoes the point of having one: every
 * internal link is a vote, and these would all be votes for the wrong URL.
 */
const categoryLinks = workCategories.map((c) => ({
  href: es ? (esCategoryPath(c.slug) ?? `/work/${c.slug}/`) : `/work/${c.slug}/`,
  label: es ? (esCategories[c.slug]?.name ?? c.name) : c.name,
}));
---

<footer id="contact" data-pagefind-ignore data-band class="band-ink">
  <div class="shell section">
    <div class="footer__top">
      <div>
        <WallLabel items={t.label} />
        <h2 data-reveal="lines" class="footer__title display-title">
          {
            t.titleLines.map((line) => (
              <span data-line class="block">
                {line}
              </span>
            ))
          }
        </h2>

        <a href={t.ctaHref} class="btn btn--ghost mt-8" data-magnetic="0.2">
          {t.cta}
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>

      <div class="footer__details" data-placeholder={contact.status}>
        <div>
          <p class="footer__label">{t.email}</p>
          <p class="footer__value">{contact.email}</p>
        </div>
        <div>
          <p class="footer__label">{t.phone}</p>
          <p class="footer__value">{contact.phone}</p>
        </div>
        <div>
          <p class="footer__label">{t.from}</p>
          <p class="footer__value">{contact.locations}</p>
        </div>
      </div>
    </div>

    <hr class="rule my-12" />

    {
      /* Sitewide links to the market pages. This is what makes them crawlable
        from every URL on the site instead of only from the home page, and it
        is the mechanism that spreads ranking authority across the set — a
        page linked from one place is treated as far less important than one
        linked from everywhere. Marked `data-pagefind-ignore` upstream so the
        site search does not return the footer on every query. */
    }
    <nav class="footer__markets" aria-label="Work">
      <p class="footer__label">{t.work}</p>
      <ul>
        {
          categoryLinks.map((c) => (
            <li>
              <a href={c.href}>{c.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <hr class="rule my-12" />

    <nav class="footer__markets" aria-label="Where we work">
      <p class="footer__label">{t.where}</p>
      <ul>
        {
          markets.map((m) => (
            <li>
              {/* The market pages are English-only for now, so a Spanish page
                  labels them in Spanish but still sends the reader to the URL
                  that exists. Translating them is the next batch. */}
              <a href={`/${m.slug}/`}>{t.marketingIn} {m.name}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <hr class="rule my-12" />

    <div class="footer__bottom">
      <a href={es ? "/es/" : "/"} aria-label="JP Media Groups">
        <Image
          src={logo}
          alt="JP Media Groups"
          widths={[200, 400]}
          loading="lazy"
          class="h-8 w-auto"
        />
      </a>

      <nav aria-label="Footer">
        <ul class="footer__nav">
          {
            (es ? esUi.nav : nav).map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <ul class="footer__socials">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="footer__social"
                data-magnetic="0.3"
                aria-label={s.name}
              >
                <Icon name={s.icon} class="h-[18px] w-[18px]" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {
      /* The licensing page is linked from every URL on the site on purpose.
        It is what `license` / `acquireLicensePage` in the gallery schema point
        at, and Google crawls an orphan page late or not at all — which would
        leave the image metadata pointing somewhere it has never fetched. */
    }
    <p class="footer__legal">
      © {year} JP Media Groups. {studio.years} {t.years} {
        studio.cities.join(", ")
      }. <a href="/licensing/" class="footer__legal-link">{t.licensing}</a>.
    </p>
  </div>
</footer>

<style>
  .footer__top {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .footer__top {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 5rem;
    }
  }

  .footer__title {
    font-size: var(--text-h1);
    font-weight: 800;
  }

  .footer__details {
    display: grid;
    gap: 1.75rem;
    align-content: start;
  }
  @media (min-width: 640px) {
    .footer__details {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .footer__label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8ba3a8;
  }
  .footer__value {
    margin-top: 0.35rem;
    font-size: 1.0625rem;
    color: #fff;
  }

  .footer__markets ul {
    display: grid;
    gap: 0.6rem 2rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }
  @media (min-width: 640px) {
    .footer__markets ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .footer__markets ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .footer__markets a {
    color: #d8e0e2;
  }
  .footer__markets a:hover {
    color: var(--color-verde);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9375rem;
  }
  .footer__nav a {
    color: #d8e0e2;
  }
  .footer__nav a:hover {
    color: var(--color-verde);
  }

  .footer__socials {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer__social {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-hairline-dark);
    border-radius: 999px;
    color: #fff;
    transition:
      background-color var(--duration-micro) var(--ease-soft),
      border-color var(--duration-micro) var(--ease-soft),
      color var(--duration-micro) var(--ease-soft);
  }
  .footer__social:hover,
  .footer__social:focus-visible {
    background: var(--color-verde);
    border-color: var(--color-verde);
    color: var(--color-ink);
  }

  .footer__legal {
    margin-top: 2.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #7e969b;
  }
  .footer__legal-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    transition: color var(--duration-micro) var(--ease-soft);
  }
  .footer__legal-link:hover,
  .footer__legal-link:focus-visible {
    color: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__social {
      transition: none;
    }
  }
</style>
