---
/**
 * Every tag a crawler or a link preview reads, in one place.
 *
 * Only `BaseLayout` renders this, and it renders it once. Pages describe
 * themselves by handing a `PageSeo` record down — see src/lib/seo.ts, where
 * the copy and the structured data live.
 *
 * Ordering matters slightly: charset and viewport must be inside the first
 * 1024 bytes of the document or the browser re-parses the head, so they stay
 * ahead of everything else.
 */
import {
  SITE_NAME,
  LOCALE,
  LOCALE_ALT,
  LANG,
  OG,
  GEO,
  abs,
  jsonLd,
  type PageSeo,
} from "../lib/seo";

interface Props {
  page: PageSeo;
}

const { page } = Astro.props;

// Canonical is built from the site origin, never from the request host, so a
// preview deploy or a www/non-www split cannot split the ranking signal in two.
//
// The trailing slash is normalised: /contact and /contact/ are two URLs to a
// crawler and only one of them should ever be declared canonical.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonical = abs(path === "/" ? "/" : `${path}/`);

const image = abs(page.image ?? OG.image);
const imageAlt = page.imageAlt ?? OG.alt;
const type = page.type ?? "website";

// index,follow with the preview limits opened up. `max-image-preview:large` is
// the one that matters commercially: without it Google renders a thumbnail
// instead of a large image, and for a photography studio the large image is
// most of the reason someone clicks.
const robots = page.noindex
  ? "noindex, nofollow"
  : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1";

const schema = jsonLd(page, canonical);
---

{/* --- Core ------------------------------------------------------------- */}
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{page.title}</title>
<meta name="description" content={page.description} />
<link rel="canonical" href={canonical} />

<meta name="robots" content={robots} />
<meta name="googlebot" content={robots} />

{
  /* One language, stated rather than left for Google to infer. `x-default`
    points at the same URL: there is no alternate to send anyone to yet. */
}
<link rel="alternate" hreflang={LANG} href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />

<meta name="author" content={SITE_NAME} />
<meta name="publisher" content={SITE_NAME} />
<meta name="generator" content={Astro.generator} />

{/* --- Local ------------------------------------------------------------ */}
{
  /* Google ignores these; Bing and several local directories still read them. */
}
<meta name="geo.region" content={GEO.region} />
<meta name="geo.placename" content={GEO.placename} />

{/* --- Open Graph ------------------------------------------------------- */}
{
  /* Facebook, WhatsApp, LinkedIn, iMessage, Slack, Discord and Telegram all
    read this block. Absolute image URLs are mandatory — most of them refuse a
    relative one silently and render no card at all. */
}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={page.title} />
<meta property="og:description" content={page.description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={LOCALE} />
{LOCALE_ALT.map((l) => <meta property="og:locale:alternate" content={l} />)}
<meta property="og:image" content={image} />
<meta property="og:image:secure_url" content={image} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content={String(OG.width)} />
<meta property="og:image:height" content={String(OG.height)} />
<meta property="og:image:alt" content={imageAlt} />

{/* --- X / Twitter ------------------------------------------------------ */}
{
  /* `summary_large_image` is what turns the link into a full-bleed card.
    Add `twitter:site` and `twitter:creator` once the studio has a handle. */
}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={page.title} />
<meta name="twitter:description" content={page.description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />

{/* --- Icons and app surfaces ------------------------------------------- */}
{
  /* SVG first for the sharp tab icon, PNG behind it for the clients that still
    refuse SVG, then the home-screen icon and the manifest. */
}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png" />
<link
  rel="apple-touch-icon"
  href="/icons/apple-touch-icon.png"
  sizes="180x180"
/>
<link rel="manifest" href="/site.webmanifest" />
<meta name="apple-mobile-web-app-title" content={SITE_NAME} />
<meta name="application-name" content={SITE_NAME} />
<meta name="msapplication-TileColor" content="#12232B" />

{
  /* Salt in light, ink in dark — the browser chrome matches the page instead of
    fighting it. */
}
<meta
  name="theme-color"
  content="#edefec"
  media="(prefers-color-scheme: light)"
/>
<meta
  name="theme-color"
  content="#12232B"
  media="(prefers-color-scheme: dark)"
/>

{/* --- Discovery -------------------------------------------------------- */}
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

{/* --- Structured data -------------------------------------------------- */}
{
  /* One graph, not several blocks: nodes in separate <script> tags cannot cite
    each other by @id, which is what keeps the business, the page and the trail
    resolving to a single entity. */
}
<script type="application/ld+json" is:inline set:html={schema} />
