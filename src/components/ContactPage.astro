---
/**
 * Contact. The header and footer CTAs point here, and the form is the one real
 * function the WordPress contact page had. Its copy was theme demo, so the
 * page is rewritten around the studio's actual disciplines.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import WallLabel from "./WallLabel.astro";
import Icon from "./Icon.astro";
import { contact, studio, services, socials, faq } from "../content/site";
import { pages } from "../lib/seo";
import { emailjs, emailjsReady, isDev } from "../lib/env";
import { esContact, esFaq, esHome, esUi } from "../content/site.es";
import type { Locale } from "../lib/i18n";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
const es = lang === "es";

/**
 * The form's field NAMES are never localised.
 *
 * `sendForm` turns every `name` attribute into an EmailJS template variable, so
 * renaming `message` to `mensaje` on the Spanish page would silently deliver an
 * empty brief — the send succeeds, the email arrives blank. Labels are
 * translated; the contract with the dashboard is not.
 */
const t = es
  ? {
      seo: pages.contactEs,
      label: esContact.label,
      titleLines: esContact.titleLines,
      form: esContact.form,
      emailLabel: esContact.emailLabel,
      phoneLabel: esContact.phoneLabel,
      fromLabel: esContact.fromLabel,
      disciplines: esContact.disciplinesLabel,
      services: esHome.services.map((s) => s.title),
      faq: esFaq,
      home: esUi.home,
      crumb: esContact.crumb,
    }
  : {
      seo: pages.contact,
      label: contact.label,
      titleLines: contact.titleLines,
      form: {
        name: "Name",
        email: "Email",
        discipline: "What you need",
        disciplinePlaceholder: "Pick a discipline",
        message: "Tell us about the project",
        submit: "Send",
        sending: "Sending…",
        sent: "Sent. We'll be in touch shortly.",
        error: "Could not send. Write to us directly at ",
      },
      emailLabel: "Email",
      phoneLabel: "Phone",
      fromLabel: "Working from",
      disciplines: "Disciplines",
      services: services.items.map((s) => s.title),
      faq,
      home: "Home",
      crumb: "Contact",
    };

/**
 * The form sends through EmailJS, which relays it to the studio's inbox.
 *
 * ── ONE THING THIS COSTS, STATED PLAINLY ──────────────────────────────────
 * EmailJS is a JavaScript API. There is no URL a browser can natively POST a
 * form to, so unlike the previous Web3Forms setup this form does NOT work
 * without JavaScript. `action` and `method` are gone rather than left in
 * pointing at nothing, and a <noscript> block gives that visitor the email
 * address and phone number instead of a button that silently does nothing.
 * ─────────────────────────────────────────────────────────────────────────
 *
 * The field `name` attributes are the contract with the EmailJS template:
 * `sendForm` turns each one into a template variable. Renaming a field here
 * without renaming `{{it}}` in the dashboard template silently ships empty
 * emails - the send still succeeds, the message just arrives blank.
 *
 *   name        → {{name}}
 *   email       → {{email}}        ← set the template's Reply To to this
 *   discipline  → {{discipline}}
 *   message     → {{message}}
 *   subject     → {{subject}}      ← written by the script, see below
 */
const configured = emailjsReady;
---

<BaseLayout seo={t.seo}>
  <section class="section pt-[calc(var(--header-height)+4rem)]">
    <div class="shell">
      <WallLabel items={t.label} />
      <h1 data-reveal="lines" class="contact__title display-title">
        {
          t.titleLines.map((line) => (
            <span data-line class="block">
              {line}
            </span>
          ))
        }
      </h1>

      <div class="contact__grid">
        {
          /* No `action`/`method`: EmailJS has no endpoint a browser can post to
            natively, and an action that cannot work is worse than none. The
            identifiers ride on data attributes so the script needs no build-time
            template interpolation of its own. */
        }
        <form
          class="contact-form"
          data-contact
          data-configured={configured ? "" : undefined}
          data-service={emailjs.serviceId}
          data-template={emailjs.templateId}
          data-key={emailjs.publicKey}
          novalidate
          {...(es
            ? {
                /* The script's own copy, handed down rather than duplicated in
                   a second script. Without this the Spanish page validated in
                   Spanish-labelled fields and then told the visitor "Please
                   enter a valid email address" — which is exactly the seam that
                   makes a translated site feel machine-made. */
                "data-msg-name": "Dinos tu nombre.",
                "data-msg-email": "Escribe un email válido.",
                "data-msg-message": "Cuéntanos algo del proyecto.",
                "data-msg-required": "Este campo es obligatorio.",
                "data-msg-sending": "Enviando…",
                "data-msg-ok":
                  "Gracias — tu mensaje va en camino. Solemos responder en dos días hábiles.",
                "data-msg-fail": `No se pudo enviar. Escríbenos a ${contact.email}.`,
                "data-msg-unconfigured": `El formulario todavía no está configurado. Escríbenos a ${contact.email}.`,
              }
            : {})}
        >
          {
            /* Overwritten by the script with the sender's name, so the inbox is
              scannable. Use `{{subject}}` in the template's Subject field. */
          }
          <input
            type="hidden"
            name="subject"
            value="New project brief - jpmediagroups.com"
          />

          {
            /* Honeypot. Unlike Web3Forms, EmailJS has no server-side honeypot -
              the check below in the script is the whole of it, and a ticked box
              aborts before anything is sent. Hidden from sight, from screen
              readers and from tab order: all three, or it becomes a trap for
              real people using a keyboard. */
          }
          <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            style="display:none"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <div class="field">
            <label class="field__label" for="name">{t.form.name}</label>
            <input
              class="field__input"
              id="name"
              name="name"
              type="text"
              required
              autocomplete="name"
            />
            <span class="field__rule" aria-hidden="true"></span>
            <span class="field__error" data-error-for="name"></span>
          </div>

          <div class="field">
            <label class="field__label" for="email">{t.form.email}</label>
            <input
              class="field__input"
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
            />
            <span class="field__rule" aria-hidden="true"></span>
            <span class="field__error" data-error-for="email"></span>
          </div>

          <div class="field">
            <label class="field__label" for="discipline">{t.form.discipline}</label>
            <select class="field__input" id="discipline" name="discipline">
              {/* The VALUES stay in English: they land in the studio inbox, which
                  is read in both languages, and changing them per locale would
                  make the same enquiry arrive under two different labels. */}
              {t.services.map((d, i) => (
                <option value={studio.disciplines[i] ?? d}>{d}</option>
              ))}
              <option value="Not sure yet">
                {es ? "Todavía no sé" : "Not sure yet"}
              </option>
            </select>
            <span class="field__rule" aria-hidden="true"></span>
          </div>

          <div class="field">
            <label class="field__label" for="message">{t.form.message}</label>
            <textarea
              class="field__input"
              id="message"
              name="message"
              rows="4"
              required></textarea>
            <span class="field__rule" aria-hidden="true"></span>
            <span class="field__error" data-error-for="message"></span>
          </div>

          <button
            type="submit"
            class="btn btn--primary self-start"
            data-magnetic="0.2"
            data-submit
          >
            <span class="btn__label" data-submit-label>{t.form.submit}</span>
            <span class="btn__fill" aria-hidden="true"></span>
          </button>

          {
            /* `role="status"` + `aria-live="polite"` so a screen reader hears the
              result without the focus being yanked out of the form. */
          }
          <p
            class="contact-form__status"
            role="status"
            aria-live="polite"
            data-contact-status
          >
          </p>

          {
            /* The whole of the no-JavaScript story. EmailJS cannot send without
              it, so rather than leave a dead button, the visitor is handed the
              two things that do work everywhere. */
          }
          <noscript>
            <p class="contact-form__noscript">
              {
                es
                  ? "Este formulario necesita JavaScript para enviarse. Escríbenos a "
                  : "This form needs JavaScript to send. Email us at "
              }
              <a href={`mailto:${contact.email}`}>{contact.email}</a>
              {es ? " o llámanos al " : " or call "}
              <a href={`tel:${contact.phone.replace(/[^+\d]/g, "")}`}
                >{contact.phone}</a
              >.
            </p>
          </noscript>

          {
            isDev && !configured && (
              <p class="contact-form__setup">
                PENDIENTE - faltan las variables de EmailJS. Copiá{" "}
                <code>.env.example</code> a <code>.env</code> y rellená{" "}
                <code>PUBLIC_EMAILJS_SERVICE_ID</code>,{" "}
                <code>PUBLIC_EMAILJS_TEMPLATE_ID</code> y{" "}
                <code>PUBLIC_EMAILJS_PUBLIC_KEY</code>. Este aviso no se
                renderiza en producción.
              </p>
            )
          }
        </form>

        <aside class="contact__aside" data-reveal="rise">
          <div data-placeholder={contact.status}>
            <p class="contact__label">{t.emailLabel}</p>
            <p class="contact__value">{contact.email}</p>

            <p class="contact__label mt-7">{t.phoneLabel}</p>
            <p class="contact__value">{contact.phone}</p>

            <p class="contact__label mt-7">{t.fromLabel}</p>
            <p class="contact__value">{contact.locations}</p>
          </div>

          <div class="mt-10">
            <p class="contact__label">{t.disciplines}</p>
            <ul class="contact__list">
              {t.services.map((s) => <li>{s}</li>)}
            </ul>
          </div>

          <ul class="mt-10 flex gap-2">
            {
              socials.map((s) => (
                <li>
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="contact__social"
                    data-magnetic="0.3"
                    aria-label={s.name}
                  >
                    <Icon name={s.icon} class="h-[18px] w-[18px]" />
                  </a>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </div>
  </section>

  {
    /* The FAQ.
       Google deprecated the FAQ rich result in May 2026, so this block earns
       its place as content or not at all - there is no SERP dropdown coming.
       It is here because "do you shoot in Spanish", "where do you work" and
       "what does wedding coverage include" are real questions with real buying
       intent behind them, and no page on this site answered a single one.

       Rendered as <details>, so the page stays scannable and every answer is
       still in the DOM for a crawler and for find-on-page. `name` is deliberately
       absent: grouping them would close one answer when another opens, and a
       visitor comparing two answers should not have to fight the page. */
  }
  <section class="section pt-0">
    <div class="shell">
      <hr class="rule mb-12" />

      <div class="faq">
        <div class="faq__head">
          <WallLabel items={t.faq.label} />
          <h2 data-reveal="rise" class="faq__title">{t.faq.title}</h2>
        </div>

        <div class="faq__list">
          {
            t.faq.items.map((item) => (
              <details class="faq__item" data-reveal="rise">
                <summary class="faq__q">
                  <span>{item.q}</span>
                  <span class="faq__mark" aria-hidden="true" />
                </summary>
                <p class="faq__a">{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- FAQ -------------------------------------------------------------- */

  .faq {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 1024px) {
    .faq {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 4rem;
      align-items: start;
    }
  }

  .faq__title {
    margin-top: 1.25rem;
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    letter-spacing: var(--text-h2--letter-spacing);
    font-weight: 700;
  }

  .faq__list {
    display: grid;
  }

  .faq__item {
    border-top: 1px solid var(--color-hairline);
  }
  .faq__item:last-child {
    border-bottom: 1px solid var(--color-hairline);
  }

  .faq__q {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 0;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.4;
    list-style: none;
    transition: color var(--duration-micro) var(--ease-soft);
  }
  /* Safari draws its own triangle through ::-webkit-details-marker, which
     `list-style: none` alone does not remove. */
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__q:hover {
    color: var(--color-signal-deep);
  }

  /* A plus that becomes a minus. Built from two pseudo-elements rather than an
     icon so it can rotate against the open state with no JavaScript. */
  .faq__mark {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
    margin-top: 0.35rem;
  }
  .faq__mark::before,
  .faq__mark::after {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    background: currentColor;
  }
  .faq__mark::before {
    width: 14px;
    height: 1.5px;
  }
  .faq__mark::after {
    width: 1.5px;
    height: 14px;
    transition: transform var(--duration-micro) var(--ease-signature);
  }
  .faq__item[open] .faq__mark::after {
    transform: scaleY(0);
  }

  .faq__a {
    margin: 0;
    padding: 0 0 1.5rem;
    max-width: 62ch;
    line-height: 1.75;
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__q,
    .faq__mark::after {
      transition: none;
    }
  }

  .contact__title {
    font-size: var(--text-h1);
    font-weight: 800;
    margin-bottom: 3.5rem;
  }

  .contact__grid {
    display: grid;
    gap: 3.5rem;
  }
  @media (min-width: 1024px) {
    .contact__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.7fr);
      gap: 5rem;
    }
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    max-width: 34rem;
  }

  .field {
    position: relative;
  }

  .field__label {
    display: block;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    transition: color var(--duration-micro) var(--ease-soft);
  }
  .field:focus-within .field__label {
    color: var(--color-signal-deep);
  }

  .field__input {
    width: 100%;
    padding-block: 0.65rem;
    background: transparent;
    border: 0;
    border-radius: 0;
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.5;
    resize: vertical;
    outline: none;
  }
  .field__input:focus-visible {
    outline: none;
  }
  select.field__input {
    appearance: none;
    cursor: pointer;
  }

  .field__rule {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: var(--color-hairline);
  }
  .field__rule::after {
    content: "";
    position: absolute;
    inset: 0;
    height: 1.5px;
    border-radius: 2px;
    background: var(--gradient-brand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-layout) var(--ease-signature);
  }
  .field:focus-within .field__rule::after {
    transform: scaleX(1);
  }

  .field__error {
    display: block;
    margin-top: 0.5rem;
    min-height: 1.25rem;
    font-size: 0.875rem;
    color: var(--color-counter);
  }
  .field[data-invalid] .field__rule {
    background: var(--color-counter);
  }

  .contact-form__status {
    margin: 0;
    min-height: 1.5rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-muted);
  }
  .contact-form__status[data-state="error"] {
    color: var(--color-counter);
  }
  /* Success reads in the identity green, and is the only place on the page
     where the gradient resolves to a single flat colour - it is a state, not
     a piece of the composition. */
  .contact-form__status[data-state="ok"] {
    color: var(--color-signal-deep);
    font-weight: 500;
  }

  /* The button carries the busy state; the status line just narrates it. */
  .contact-form button[disabled] {
    opacity: 0.55;
    cursor: progress;
  }

  /* Shown only when JavaScript is off, where the form cannot send at all. */
  .contact-form__noscript {
    margin: 0;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--color-hairline);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-muted);
  }
  .contact-form__noscript a {
    color: var(--color-signal-deep);
  }

  /* Dev-only. Mirrors the `data-placeholder` badge used for pending copy. */
  .contact-form__setup {
    margin: 0;
    padding: 0.75rem 1rem;
    border: 1px dashed var(--color-counter);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.7;
    color: var(--color-counter);
  }
  .contact-form__setup code {
    font-family: inherit;
    font-weight: 700;
  }

  .contact__label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .contact__value {
    margin-top: 0.3rem;
    font-size: 1.0625rem;
  }

  .contact__list {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    line-height: 1.9;
    color: var(--color-muted);
  }

  .contact__social {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-hairline);
    border-radius: 999px;
    transition:
      background-color var(--duration-micro) var(--ease-soft),
      border-color var(--duration-micro) var(--ease-soft),
      color var(--duration-micro) var(--ease-soft);
  }
  .contact__social:hover,
  .contact__social:focus-visible {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .field__rule::after,
    .field__label,
    .contact__social {
      transition: none;
    }
  }

  @media (min-width: 1024px) {
    .contact__title,
    .contact__grid {
      margin-inline-start: var(--rail);
    }
  }
</style>

<script>
  /**
   * Submits the brief through EmailJS without leaving the page.
   *
   * Unlike the Web3Forms setup this replaced, the send itself lives here -
   * EmailJS has no endpoint a browser can post to natively, so there is no
   * no-JavaScript path and the <noscript> block in the markup carries that
   * visitor instead.
   *
   * The SDK is imported dynamically, on first interaction rather than on page
   * load. It is ~4KB gzipped and only ever needed by somebody who is actually
   * writing a brief, so paying for it up front on every visit to /contact/ -
   * most of which never touch the form - would be spending the JS budget on
   * nothing. Warming it at the first focus means it is already parsed by the
   * time anyone finishes typing.
   */
  type EmailJS = typeof import("@emailjs/browser");
  let sdk: Promise<EmailJS> | null = null;
  const loadSdk = () => (sdk ??= import("@emailjs/browser"));

  function setupContact() {
    const form = document.querySelector<HTMLFormElement>("[data-contact]");
    const status = document.querySelector<HTMLElement>("[data-contact-status]");
    if (!form || !status) return;

    const button = form.querySelector<HTMLButtonElement>("[data-submit]");
    const label = form.querySelector<HTMLElement>("[data-submit-label]");
    const configured = form.hasAttribute("data-configured");
    const idle = label?.textContent ?? "Send brief";

    const serviceId = form.dataset.service ?? "";
    const templateId = form.dataset.template ?? "";
    const publicKey = form.dataset.key ?? "";

    // Nothing is fetched until somebody actually engages with the form.
    form.addEventListener("focusin", () => configured && loadSdk(), {
      once: true,
    });

    // Copy comes off the form when the page supplied it, so one script serves
    // both languages instead of two scripts drifting apart.
    const d = form.dataset;
    const messages: Record<string, string> = {
      name: d.msgName ?? "Please tell us your name.",
      email: d.msgEmail ?? "Please enter a valid email address.",
      message: d.msgMessage ?? "Please tell us a little about the project.",
    };
    const REQUIRED = d.msgRequired ?? "This field is required.";
    const SENDING = d.msgSending ?? "Sending…";

    const say = (state: "error" | "ok" | "busy", text: string) => {
      status.dataset.state = state;
      status.textContent = text;
    };

    /**
     * Marks every required field and returns the first one that failed.
     *
     * A `const` arrow rather than a function declaration: a declaration is
     * hoisted above the null guard on `form`, so TypeScript stops trusting the
     * narrowing and flags every use inside as possibly null.
     */
    const validate = (): HTMLElement | null => {
      let firstInvalid: HTMLElement | null = null;

      form
        .querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[required]")
        .forEach((el) => {
          const field = el.closest<HTMLElement>(".field");
          const error = form.querySelector<HTMLElement>(
            `[data-error-for="${el.name}"]`,
          );
          const ok = el.checkValidity() && el.value.trim() !== "";

          field?.toggleAttribute("data-invalid", !ok);
          if (error)
            error.textContent = ok
              ? ""
              : (messages[el.name] ?? REQUIRED);
          if (!ok && !firstInvalid) firstInvalid = el;
        });

      return firstInvalid;
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const firstInvalid = validate();
      if (firstInvalid) {
        say("error", d.msgFix ?? "Please fix the highlighted fields.");
        (firstInvalid as HTMLElement).focus();
        return;
      }

      // The honeypot, checked here because EmailJS has no server-side one.
      // A bot that fills every field it finds ticks this; a person never sees
      // it. Reported as success on purpose - telling a bot it was blocked just
      // teaches whoever wrote it which field to skip next time.
      const trap = form.querySelector<HTMLInputElement>(
        'input[name="botcheck"]',
      );
      if (trap?.checked) {
        form.reset();
        say("ok", "Thank you - your brief is on its way.");
        return;
      }

      if (!configured) {
        say("error", d.msgUnconfigured ?? "Form endpoint not configured yet.");
        return;
      }

      // Locked for the whole request so an impatient second click cannot send
      // the brief twice.
      const lock = (busy: boolean) => {
        if (button) button.disabled = busy;
        form.setAttribute("aria-busy", String(busy));
        if (label) label.textContent = busy ? SENDING : idle;
      };

      lock(true);
      say("busy", SENDING);

      // A subject that names the sender, so the inbox is scannable instead of
      // forty identical rows. `sendForm` reads the form element itself, so this
      // is set on the field rather than on a detached FormData copy.
      const nameField = form.querySelector<HTMLInputElement>("#name");
      const subject = form.querySelector<HTMLInputElement>(
        'input[name="subject"]',
      );
      if (subject)
        subject.value = `New project brief - ${nameField?.value.trim() ?? ""}`;

      try {
        const emailjs = await loadSdk();

        // No `limitRate`. The SDK's throttle counts ATTEMPTS, not successes, so
        // a visitor whose first send failed on a network blip and who
        // immediately retried was told "that was sent a moment ago" about a
        // message that never left the browser. The button lock below already
        // covers the real double-submit case, which is a second click while the
        // first request is still in flight.
        await emailjs.sendForm(serviceId, templateId, form, { publicKey });

        form.reset();
        form
          .querySelectorAll<HTMLElement>("[data-invalid]")
          .forEach((f) => f.removeAttribute("data-invalid"));
        say(
          "ok",
          d.msgOk ??
            "Thank you - your brief is on its way. We usually reply within two business days.",
        );
      } catch (err) {
        // EmailJS rejects with an object carrying `status` and `text`, or with
        // a plain string when an identifier is missing. Neither is worth
        // showing raw - every branch ends by pointing at the address and phone
        // number that are printed beside the form.
        const status = (err as { status?: number } | null)?.status;
        const fallback =
          "Please email us at contact@jpmediagroups.com instead.";

        // The Spanish page hands down one sentence rather than five. A visitor
        // who has just watched a send fail needs the address, not a taxonomy of
        // what went wrong — the branching below only earns its keep in the
        // language the rest of the page is already written in.
        const message = d.msgFail
          ? navigator.onLine === false
            ? "Sin conexión. Revisa la red e inténtalo de nuevo."
            : d.msgFail
          : status === 429
            ? `That was sent a moment ago. Give it a few seconds, or ${fallback.toLowerCase()}`
            : status === 403
              ? `We could not send that. ${fallback}`
              : status && status >= 500
                ? `The mail service is down right now. ${fallback}`
                : navigator.onLine === false
                  ? "No connection. Check your network and try again."
                  : `Something went wrong. ${fallback}`;

        say("error", message);
      } finally {
        lock(false);
      }
    });
  }

  document.addEventListener("astro:page-load", setupContact);
</script>
