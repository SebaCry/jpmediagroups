---
/**
 * Where the studio works, as real content and as the entry point to /utah/.
 *
 * This used to be a five-row coverage index across two countries. It is one
 * row now, and the section still earns its place for both of the reasons it
 * always did:
 *
 *   1. It is the one block on the home page that states the service area
 *      plainly, in indexable text, in a heading. The marquee is `aria-hidden`
 *      and the About prose is discursive; a crawler reading this page for
 *      "where does this business operate" reads this H2. While a Business
 *      Profile appeal is open that is the most useful sentence on the site.
 *
 *   2. /utah/ needs a link. A page with nothing pointing at it is crawled
 *      last, ranked lowest, and inherits none of the home page's authority.
 *
 * A one-item list is not a mistake to be tidied away. It renders from
 * `markets`, so it is still correct the day a second service area exists, and
 * a single row reads as a statement rather than as a menu — which is what one
 * service area actually is.
 */
import WallLabel from "../WallLabel.astro";
import { markets, studio } from "../../content/site";
---

<section id="markets" class="section">
  <div class="shell">
    {
      /* `${markets.length} markets` used to sit in the middle slot. With one
         record it printed "1 markets", and the fix is not pluralisation — the
         label should name the place, which is the fact worth stating. */
    }
    <WallLabel
      items={["Where we work", "Utah", `${studio.years} years`]}
    />

    <h2 data-reveal="lines" class="markets__title display-title">
      <span data-line class="block">Video, photography</span>
      <span data-line class="block markets__accent">and marketing</span>
      <span data-line class="block">in Utah</span>
    </h2>

    <p data-reveal="rise" class="lead markets__lead">
      Based in Salt Lake City and working across the state. That is the whole
      service area — every project produced locally, in English and in Spanish.
    </p>

    <ul class="markets__list">
      {
        markets.map((m) => (
          <li class="market-card" data-reveal="rise">
            <a href={`/${m.slug}/`} class="market-card__link">
              <h3 class="market-card__name">{m.name}</h3>
              <p class="market-card__cities">{m.cities.join(" · ")}</p>
              <p class="market-card__leads">{m.leads.join(" · ")}</p>
              <span class="market-card__cue" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .markets__title {
    font-size: var(--text-h1);
    font-weight: 800;
    line-height: 0.98;
  }
  .markets__accent {
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .markets__lead {
    margin-top: 1.75rem;
    max-width: 46ch;
  }

  .markets__list {
    display: grid;
    gap: 0;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-hairline);
  }

  .market-card {
    border-bottom: 1px solid var(--color-hairline);
  }

  /* A typographic index, matching the Services block. Five markets is a list,
     and a list is what a coverage map actually is. */
  .market-card__link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.35rem 1.5rem;
    padding-block: 1.5rem;
    align-items: baseline;
  }
  @media (min-width: 768px) {
    .market-card__link {
      grid-template-columns: minmax(0, 0.5fr) minmax(0, 0.5fr) minmax(
          0,
          1fr
        ) auto;
      gap: 2rem;
      padding-block: 1.75rem;
    }
  }

  .market-card__name {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    transition: color var(--duration-micro) var(--ease-soft);
  }
  .market-card__link:hover .market-card__name,
  .market-card__link:focus-visible .market-card__name {
    color: var(--color-signal-deep);
  }

  .market-card__cities,
  .market-card__leads {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .market-card__leads {
    grid-column: 1 / -1;
  }
  @media (min-width: 768px) {
    .market-card__leads {
      grid-column: auto;
      text-align: left;
    }
  }

  .market-card__cue {
    grid-row: 1;
    grid-column: -1;
    font-size: 1.25rem;
    color: var(--color-muted);
    transition: transform var(--duration-micro) var(--ease-signature);
  }
  .market-card__link:hover .market-card__cue,
  .market-card__link:focus-visible .market-card__cue {
    transform: translateX(6px);
    color: var(--color-signal-deep);
  }

  @media (prefers-reduced-motion: reduce) {
    .market-card__name,
    .market-card__cue {
      transition: none;
    }
  }

  @media (min-width: 1024px) {
    .markets__title,
    .markets__lead,
    .markets__list,
    :global(#markets) > .shell > .wall-label {
      margin-inline-start: var(--rail);
    }
  }
</style>
