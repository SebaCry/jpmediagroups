---
/**
 * The portfolio, on the home page.
 *
 * Replaces the old placeholder gallery, which held five invented case studies
 * behind abstract plates. This shows the real categories instead, and links
 * each one to its own page — so the home page stops being the only indexable
 * thing on the site and starts feeding six pages that carry photographs.
 *
 * Covers come from `src/assets/work/<slug>/`; a category with nothing in it
 * yet renders a labelled frame rather than a stand-in image.
 */
import { Image } from "astro:assets";
import WallLabel from "../WallLabel.astro";
import Icon from "../Icon.astro";
import { workCategories, driveFolder } from "../../content/site";
import { cover, galleryCount } from "../../lib/images";
import { esCategories, esUi, esWork, esHome } from "../../content/site.es";
import { localeOf, esCategoryPath } from "../../lib/i18n";

const es = localeOf(Astro.url.pathname) === "es";

/* On the Spanish home only the categories that exist in Spanish are shown. A
   card that links into the English site is a dead end for a reader who arrived
   in Spanish, and a vote for the wrong URL for a crawler. */
const items = workCategories
  .filter((c) => (es ? Boolean(esCategories[c.slug]) : true))
  .map((c) => ({
    ...c,
    name: es ? (esCategories[c.slug]?.name ?? c.name) : c.name,
    short: es ? (esCategories[c.slug]?.short ?? c.short) : c.short,
    href: es ? (esCategoryPath(c.slug) ?? `/work/${c.slug}/`) : `/work/${c.slug}/`,
    image: cover(c.slug),
    count: galleryCount(c.slug),
  }));
const total = items.reduce((n, c) => n + c.count, 0);
---

<section id="work" class="section">
  <div class="shell">
    <WallLabel
      items={[
        es ? esWork.label[0] : "Selected work",
        `${items.length} ${es ? "disciplinas" : "disciplines"}`,
        total ? `${total} ${es ? esUi.pieces : "pieces"}` : "Loading pending",
      ]}
    />

    <div class="teaser__head">
      <h2 data-reveal="lines" class="teaser__title display-title">
        <span data-line class="block">{es ? esHome.workTitle : "The work"}</span>
      </h2>
      <div class="teaser__actions">
        <a
          href={es ? "/es/trabajo/" : "/work/"}
          class="btn btn--primary"
          data-magnetic="0.18"
        >
          <span class="btn__label">
            {es ? esHome.workCta : "See all work"}
          </span>
          <span class="btn__fill" aria-hidden="true"></span>
        </a>
        <a
          href={driveFolder}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--ghost"
          data-magnetic="0.18"
        >
          {es ? esWork.driveCta : "Full portfolio"}
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </div>

  {
    /* A horizontal rail on every size. Categories in a grid on desktop make a
      wall of equal boxes; a rail keeps them reading as a sequence and needs no
      separate mobile treatment.

      On desktop the rail is DRIVEN BY THE PAGE SCROLL - the same pin-and-scrub
      the Team row uses, wired up by the shared `[data-pin-row]` handler in
      lib/motion.ts. Without it the rail was a plain `overflow-x` container, and
      a plain overflow container is unreachable here: Lenis owns the wheel, so
      the only way to move it was shift+wheel or a trackpad swipe. Five
      categories overflow 1440px, which meant the fourth card sat permanently
      cut in half and the fifth could not be seen at all.

      Touch and narrow screens keep the native snap carousel - pinning fights
      touch scrolling, and the CSS below already provides the fallback. */
  }
  <div class="teaser__viewport" data-pin-row>
    <ul class="teaser__track" data-pin-track>
      {
        items.map((c) => (
          <li class="tcard">
            <a href={c.href} class="tcard__link">
              <span class="tcard__frame">
                {c.image ? (
                  <Image
                    src={c.image}
                    alt={`${c.name} by JP Media Groups`}
                    widths={[400, 640, 900]}
                    sizes="(min-width: 1024px) 28vw, 72vw"
                    loading="lazy"
                    class="tcard__img"
                  />
                ) : (
                  <span class="frame-empty tcard__empty">
                    <span>{c.short}</span>
                  </span>
                )}
              </span>
              <span class="tcard__meta">
                {c.kind === "web" ? "Design & build" : c.discipline}
              </span>
              <span class="tcard__name">{c.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .teaser__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .teaser__title {
    font-size: var(--text-h1);
    font-weight: 800;
  }

  .teaser__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    flex: none;
  }

  .teaser__viewport {
    margin-top: 3rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .teaser__viewport::-webkit-scrollbar {
    display: none;
  }
  /* Added by the motion module once the track is pinned - native scrolling and
     a pinned translate must not both be live at the same time, or the rail
     fights itself and lands somewhere neither of them meant. */
  .teaser__viewport.is-pinned {
    overflow: hidden;
    scroll-snap-type: none;
  }

  .teaser__track {
    display: flex;
    gap: 1.25rem;
    width: max-content;
    margin: 0;
    padding: 0 var(--spacing-gutter);
    list-style: none;
    will-change: transform;
  }
  @media (min-width: 1024px) {
    .teaser__track {
      padding-inline: max(
        var(--spacing-gutter),
        calc((100vw - var(--container-shell)) / 2)
      );
    }
  }

  .tcard {
    flex: none;
    width: min(72vw, 340px);
    scroll-snap-align: center;
  }
  @media (min-width: 1024px) {
    .tcard {
      width: clamp(260px, 26vw, 360px);
    }
  }

  .tcard__link {
    display: block;
    color: inherit;
  }

  .tcard__frame {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-chalk);
  }

  .tcard__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transform: scale(1.05);
    transition:
      filter var(--duration-media) var(--ease-signature),
      transform var(--duration-media) var(--ease-signature);
  }
  .tcard__link:hover .tcard__img,
  .tcard__link:focus-visible .tcard__img {
    filter: grayscale(0) contrast(1);
    transform: scale(1);
  }

  .tcard__empty {
    width: 100%;
    height: 100%;
  }

  .tcard__meta {
    display: block;
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .tcard__name {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    transition: color var(--duration-micro) var(--ease-soft);
  }
  .tcard__link:hover .tcard__name,
  .tcard__link:focus-visible .tcard__name {
    color: var(--color-signal-deep);
  }

  @media (prefers-reduced-motion: reduce) {
    .tcard__img,
    .tcard__name {
      transition: none;
      filter: none;
      transform: none;
    }
  }

  @media (min-width: 1024px) {
    .teaser__head,
    :global(#work) > .shell > .wall-label {
      margin-inline-start: var(--rail);
    }
  }
</style>
