---
import { Image } from "astro:assets";
import WallLabel from "../WallLabel.astro";
import Icon from "../Icon.astro";
import horizon from "../../assets/plates/plate-horizon.webp";
import { hero, studio } from "../../content/site";
import { esHome } from "../../content/site.es";
import { localeOf } from "../../lib/i18n";
const es = localeOf(Astro.url.pathname) === "es";
/* One hero, two languages. The line ARRAYS differ, not just the words: the
   headline is set `nowrap` per line, so a Spanish break that works at 360px
   has to be authored, not translated into an overflow. */
const h = es
  ? { label: esHome.heroLabel, lines: esHome.heroLines, linesMobile: esHome.heroLines,
      kicker: esHome.heroKicker, primaryCta: esHome.primaryCta, secondaryCta: esHome.secondaryCta }
  : hero;
---

<section data-hero data-parallax-scope class="hero" aria-label="Introduction">
  <div class="shell">
    <div class="hero__inner">
      <WallLabel
        items={[...h.label, studio.cities.join(" · ")]}
        class="hero__label"
      />

      <h1 class="hero__title">
        {
          /* The visual copy is split into characters at runtime, which is noise to
          a screen reader - so it is hidden and the sentence is exposed once. */
        }
        <span class="sr-only"
          >{h.lines.map((l) => l.text).join(" ")} {h.kicker}</span
        >

        {
          /* Both compositions are rendered and one is shown per breakpoint. The
           whole visual block is already hidden from assistive tech - the
           sentence above is what gets read - so duplicating it costs nothing
           but a few spans, and it lets each breakpoint set its own line breaks
           and its own size.

           Plain lines are split into characters and staggered. The accent lines
           are NOT: gradient text is clipped to the element's own text, and
           per-character spans each carry their own transform, which breaks the
           clip and renders them invisible. They rise as whole lines instead -
           which also lands the accent as one gesture. */
          [
            { set: h.lines, cls: "hero__set--wide" },
            { set: h.linesMobile, cls: "hero__set--narrow" },
          ].map(({ set, cls }) => (
            <span class:list={["hero__set", cls]} aria-hidden="true">
              {set.map((line) =>
                line.accent ? (
                  <span data-hero-block class="hero__line hero__line--accent">
                    <span>{line.text}</span>
                  </span>
                ) : (
                  <span data-hero-line class="hero__line">
                    {line.text}
                  </span>
                ),
              )}
            </span>
          ))
        }
      </h1>

      <p data-hero-trail class="hero__kicker">{h.kicker}</p>

      <div data-hero-trail class="hero__actions">
        <a
          href={h.primaryCta.href}
          class="btn btn--primary"
          data-magnetic="0.22"
        >
          <span class="btn__label">{h.primaryCta.label}</span>
          <span class="btn__fill" aria-hidden="true"></span>
        </a>
        <a
          href={h.secondaryCta.href}
          class="btn btn--ghost"
          data-magnetic="0.18"
        >
          {h.secondaryCta.label}
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </div>

  {
    /* The identity gradient laid down as a horizon. It is the only large field
      of colour on the page - everything after this is salt and ink. */
  }
  <div class="hero__horizon" data-scroll-zoom aria-hidden="true">
    <Image
      src={horizon}
      alt=""
      widths={[900, 1440, 2000, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover"
    />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 65svh;
    /* Clears the fixed header. Without it the wall label renders underneath
       the nav - that collision is what the top of the page was showing. */
    padding-top: calc(var(--header-height) + 3rem);
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    padding-bottom: clamp(2.5rem, 8vh, 5rem);
  }

  .hero__label {
    margin-bottom: 2rem;
  }

  .hero__title {
    font-size: var(--text-display);
    line-height: 0.94;
    letter-spacing: -0.035em;
    font-weight: 800;
  }

  /* One composition per breakpoint. The switch is at 560px because that is
     where the wide set's 14-character line starts fitting comfortably again. */
  .hero__set {
    display: block;
  }
  .hero__set--wide {
    display: none;
  }
  @media (min-width: 560px) {
    .hero__set--wide {
      display: block;
    }
    .hero__set--narrow {
      display: none;
    }
  }

  /* Phone sizing is driven by the narrow set's longest line ("photography",
     11 characters), which is what allows ~35px at 390px instead of ~28px. */
  @media (max-width: 559px) {
    .hero__title {
      /* The 2.6rem ceiling is where the narrow set hands over to the wide one
         without a jump: left uncapped it reached ~52px at 559px and then fell
         to 36px at 560px. */
      font-size: clamp(1.7rem, -0.25rem + 10vw, 2.6rem);
      line-height: 0.92;
      letter-spacing: -0.04em;
    }
  }

  .hero__line {
    display: block;
    overflow: hidden;
    /* The authored line breaks are the composition, so they hold at every size
       the headline actually fits. */
    white-space: nowrap;
    padding-block: 0.03em;
  }

  /* Below ~400px the longest line ("Grow your Utah") no longer fits at a
     readable size, and `nowrap` was silently clipping it - invisible, because
     body carries `overflow-x: clip`. Letting it wrap loses the authored break
     on the smallest phones, which is far better than losing the words. The
     reveal mask still works: the box simply grows to two lines. */
  @media (max-width: 400px) {
    .hero__line {
      white-space: normal;
    }
  }

  /* Two lines take the identity gradient, so it reads as emphasis rather than
     as a wash. The gradient sits on the inner span, which is the element that
     actually holds the text. */
  .hero__line--accent > span {
    display: block;
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    will-change: transform;
  }

  .hero__kicker {
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 2.5rem;
  }

  /* A band, not a backdrop: the colour sits along the bottom edge like the
     stroke in the logo, and the type stays on clean salt. */
  .hero__horizon {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: clamp(70px, 12vh, 130px);
    z-index: 0;
    /* Feathered on both edges so it reads as a stroke laid along the bottom of
       the page, not as a gradient background creeping up behind the type. */
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent,
      #000 70%,
      #000 92%,
      transparent
    );
    mask-image: linear-gradient(
      to bottom,
      transparent,
      #000 70%,
      #000 92%,
      transparent
    );
    opacity: 0.75;
  }

  /* --- Phones ------------------------------------------------------------
     The hero was bottom-aligned inside 65svh with a large top pad, so on a
     short viewport everything collected into the last third of the screen and
     the buttons sat right on top of the colour band. Give it more height, less
     top pad, and real space underneath. */
  @media (max-width: 767px) {
    .hero {
      min-height: 82svh;
      padding-top: calc(var(--header-height) + 1.5rem);
    }
    .hero__inner {
      padding-bottom: clamp(4rem, 14vh, 7rem);
    }
    .hero__label {
      margin-bottom: 1.5rem;
    }
    .hero__kicker {
      margin-top: 1.25rem;
    }
    .hero__actions {
      margin-top: 2rem;
    }
    /* Full-width, stacked. Two pills side by side on a 360px screen leaves
       each one too narrow to read comfortably. */
    .hero__actions > * {
      flex: 1 1 100%;
      justify-content: center;
    }
    /* The band creeps up behind the buttons on short screens. */
    .hero__horizon {
      height: clamp(56px, 8vh, 90px);
    }
  }

  @media (min-width: 1024px) {
    .hero__inner {
      margin-inline-start: var(--rail);
    }
  }
</style>
