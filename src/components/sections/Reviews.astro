---
/**
 * Client ratings.
 *
 * The single pending quote this replaces asked a visitor to believe one
 * anonymous sentence. A rated wall does something a quote cannot: it puts a
 * number on the work, states how many people gave it, and lets the reader see
 * the spread rather than the studio's favourite line.
 *
 * The average is computed here, never authored. A stated average that does not
 * match the reviews under it is the fastest way to lose the credibility the
 * section exists to build.
 *
 * PARTIAL STARS: two identical rows of five, one outline and one filled, with
 * the filled row clipped to `rate / 5`. That renders 4.5 - or 4.3 - correctly
 * without a half-star glyph and without rounding a score up on the studio's own
 * behalf.
 *
 * NOTE ON STRUCTURED DATA: there is none here, deliberately. See the comment
 * over `testimonials` in content/site.ts.
 */
import WallLabel from "../WallLabel.astro";
import Icon from "../Icon.astro";
import { reviews, testimonials } from "../../content/site";
import { isDev } from "../../lib/env";

const count = testimonials.length;

/** Clamped, because a typo'd 50 in the content file should not draw ten stars. */
const clamp = (n: number) => Math.min(5, Math.max(0, n));

const average = count
  ? clamp(testimonials.reduce((sum, t) => sum + t.rate, 0) / count)
  : 0;

/** One decimal, and no trailing ".0" - "5" reads better than "5.0". */
const fmt = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(1));

const STARS = [0, 1, 2, 3, 4];

// Empty in production means the section does not exist. In `astro dev` it
// renders a note instead, so the gap is visible to whoever is building the site
// and invisible to everybody else.
const render = count > 0 || isDev;
---

{
  render && (
    <section id="reviews" class="section">
      <div class="shell">
        <WallLabel
          items={[
            ...reviews.label,
            /* "out of", not "4.5 / 5" - the wall label already separates its
               own facts with a slash, and the two read as one broken list. */
            count
              ? `${fmt(average)} out of 5 · ${count} reviews`
              : "Awaiting reviews",
          ]}
        />

        {/* Title full width, then the lead and the score side by side beneath
            it. A display heading at --text-h1 set into a half-width column
            re-wraps its own authored lines, which is a worse problem than the
            asymmetry this avoids. */}
        <h2 data-reveal="lines" class="reviews__title display-title">
          {reviews.titleLines.map((line, i) => (
            <span
              data-line
              class:list={[
                "block",
                i === reviews.accentLine && "reviews__accent",
              ]}
            >
              {line}
            </span>
          ))}
        </h2>

        <div class="reviews__intro">
          <div class="reviews__aside" data-reveal="rise">
            <p class="lead reviews__lead">{reviews.lead}</p>

            {count > 0 && (
              <div class="score">
                <p class="score__value">{fmt(average)}</p>
                <div class="score__meta">
                  <span
                    class="stars"
                    role="img"
                    aria-label={`${fmt(average)} out of 5`}
                  >
                    <span class="stars__row" aria-hidden="true">
                      {STARS.map(() => (
                        <Icon name="star" class="stars__glyph" />
                      ))}
                    </span>
                    <span
                      class="stars__clip"
                      style={`width: ${(average / 5) * 100}%`}
                      aria-hidden="true"
                    >
                      <span class="stars__row stars__row--fill">
                        {STARS.map(() => (
                          <Icon name="star" class="stars__glyph" />
                        ))}
                      </span>
                    </span>
                  </span>
                  <p class="score__count">
                    {count === 1 ? "1 review" : `${count} reviews`}
                  </p>
                </div>
              </div>
            )}
          </div>
        </div>

        {count > 0 ? (
          <ul class="reviews__grid">
            {testimonials.map((t) => {
              const rate = clamp(t.rate);
              return (
                <li class="review" data-reveal="rise">
                  <figure class="review__figure">
                    <span
                      class="stars review__stars"
                      role="img"
                      aria-label={`${fmt(rate)} out of 5`}
                    >
                      <span class="stars__row" aria-hidden="true">
                        {STARS.map(() => (
                          <Icon name="star" class="stars__glyph" />
                        ))}
                      </span>
                      <span
                        class="stars__clip"
                        style={`width: ${(rate / 5) * 100}%`}
                        aria-hidden="true"
                      >
                        <span class="stars__row stars__row--fill">
                          {STARS.map(() => (
                            <Icon name="star" class="stars__glyph" />
                          ))}
                        </span>
                      </span>
                    </span>

                    <blockquote class="review__quote">
                      <p>{t.testimonial}</p>
                    </blockquote>

                    <figcaption class="review__by">
                      <span class="review__name">{t.person}</span>
                      {t.role && <span class="review__role">{t.role}</span>}
                      <span class="review__year">{t.year}</span>
                    </figcaption>
                  </figure>
                </li>
              );
            })}
          </ul>
        ) : (
          /* Dev only - see the note above. */
          <div class="awaiting" data-placeholder={reviews.status}>
            <p class="awaiting__title">No reviews loaded yet</p>
            <p class="awaiting__body">
              Add entries to <code>testimonials</code> in{" "}
              <code>src/content/site.ts</code> - each one needs a{" "}
              <code>person</code>, a <code>testimonial</code>, a{" "}
              <code>rate</code> out of 5 and a <code>year</code>. The average and
              the count work themselves out. This whole section does not render
              in production while the list is empty.
            </p>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .reviews__intro {
    margin-top: 2rem;
  }

  .reviews__title {
    font-size: var(--text-h1);
    font-weight: 800;
    line-height: 0.98;
  }
  .reviews__accent {
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .reviews__aside {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .reviews__lead {
    max-width: 44ch;
  }

  /* --- The headline number ---------------------------------------------- */

  .score {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-hairline);
  }
  .score__value {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .score__meta {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .score__count {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* Lead and score share a line once there is room. Declared here, after the
     two rules it overrides - a media query that precedes them loses on source
     order and quietly leaves half its declarations standing, which is how
     `align-items: end` ended up pushing a column layout to the right edge. */
  @media (min-width: 768px) {
    .reviews__aside {
      flex-direction: row;
      align-items: end;
      justify-content: space-between;
      gap: 3rem;
    }
    .score {
      flex: none;
      padding-top: 0;
      border-top: 0;
    }
  }

  /* --- Stars -------------------------------------------------------------
     Two stacked rows, the filled one clipped to the score. The base row is the
     one in flow, so it sets the height and the clip has something definite to
     resolve its 100% against.                                               */

  /* `align-self: start` matters more than it looks. Both places these stars
     appear, they sit inside a column flex container, which stretches them to
     the container's full width - and `.stars__clip`, whose width is a
     percentage of that box, then covers all five stars whatever the score was.
     Shrink-to-fit is what makes the percentage mean "of the five stars". */
  .stars {
    position: relative;
    display: inline-block;
    align-self: start;
    line-height: 0;
  }
  .stars__row {
    display: flex;
    gap: 0.2em;
  }
  .stars__clip {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    overflow: hidden;
  }
  /* `max-content`, or the clipped row would reflow to the clip's width and the
     stars inside it would slide instead of being cut. */
  .stars__row--fill {
    width: max-content;
  }

  /* `:global` on the glyph itself, not on the row.
     <Icon> writes its SVG with `set:html`, and Astro's scoper cannot stamp its
     cid onto markup it did not compile - a plain `.stars__glyph` rule here
     would compile to `.stars__glyph[data-astro-cid-…]` and match nothing. The
     row around it is real template markup, so it still carries the scope and
     the selector stays confined to this component. */
  .stars__row :global(.stars__glyph) {
    flex: none;
    width: 1em;
    height: 1em;
    font-size: 1rem;
    /* The base row is drawn hollow. The presentational `fill` on the SVG has
       zero specificity, so this wins without !important. */
    fill: none;
    stroke: var(--color-hairline);
  }
  .stars__row--fill :global(.stars__glyph) {
    fill: var(--color-signal-deep);
    stroke: var(--color-signal-deep);
  }

  /* --- The cards -------------------------------------------------------- */

  .reviews__grid {
    display: grid;
    gap: 1.25rem;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 768px) {
    .reviews__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1280px) {
    .reviews__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .review__figure {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    height: 100%;
    margin: 0;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--color-chalk);
    border: 1px solid var(--color-hairline);
    transition: border-color var(--duration-micro) var(--ease-soft);
  }
  .review:hover .review__figure {
    border-color: var(--color-signal-deep);
  }

  .review__stars {
    font-size: 1.0625rem;
  }

  .review__quote {
    margin: 0;
    /* Pushes the caption to the bottom edge so cards of different quote lengths
       still line their attributions up. */
    flex: 1;
  }
  .review__quote p {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.015em;
  }

  .review__by {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-hairline);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .review__name {
    color: var(--color-ink);
  }
  .review__role,
  .review__year {
    color: var(--color-muted);
  }
  .review__year {
    margin-inline-start: auto;
  }

  /* --- Nothing loaded, dev only ----------------------------------------- */

  .awaiting {
    margin-top: 3rem;
    padding: 2.5rem;
    border: 1px dashed var(--color-hairline);
    text-align: center;
  }
  .awaiting__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
  }
  .awaiting__body {
    margin: 0.75rem auto 0;
    max-width: 56ch;
    line-height: 1.7;
    color: var(--color-muted);
  }
  .awaiting code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--color-signal-deep);
  }

  @media (prefers-reduced-motion: reduce) {
    .review__figure {
      transition: none;
    }
  }

  @media (min-width: 1024px) {
    .reviews__title,
    .reviews__intro,
    .reviews__grid,
    .awaiting,
    :global(#reviews) > .shell > .wall-label {
      margin-inline-start: var(--rail);
    }
  }
</style>
