---
/**
 * Contact. The header and footer CTAs point here, and the form is the one real
 * function the WordPress contact page had. Its copy was theme demo, so the
 * page is rewritten around the studio's actual disciplines.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import WallLabel from '../components/WallLabel.astro';
import Icon from '../components/Icon.astro';
import { contact, studio, services, socials } from '../content/site';
import { pages } from '../lib/seo';
---

<BaseLayout seo={pages.contact}>
  <section class="section pt-[calc(var(--header-height)+4rem)]">
    <div class="shell">
      <WallLabel items={contact.label} />
      <h1 data-reveal="lines" class="contact__title display-title">
        {contact.titleLines.map((line) => <span data-line class="block">{line}</span>)}
      </h1>

      <div class="contact__grid">
        <form class="contact-form" method="post" action="#" data-contact novalidate>
          <div class="field">
            <label class="field__label" for="name">Name</label>
            <input class="field__input" id="name" name="name" type="text" required autocomplete="name" />
            <span class="field__rule" aria-hidden="true"></span>
            <span class="field__error" data-error-for="name"></span>
          </div>

          <div class="field">
            <label class="field__label" for="email">Email</label>
            <input class="field__input" id="email" name="email" type="email" required autocomplete="email" />
            <span class="field__rule" aria-hidden="true"></span>
            <span class="field__error" data-error-for="email"></span>
          </div>

          <div class="field">
            <label class="field__label" for="discipline">What do you need?</label>
            <select class="field__input" id="discipline" name="discipline">
              {studio.disciplines.map((d) => <option value={d}>{d}</option>)}
              <option value="Not sure yet">Not sure yet</option>
            </select>
            <span class="field__rule" aria-hidden="true"></span>
          </div>

          <div class="field">
            <label class="field__label" for="message">Tell us about the project</label>
            <textarea class="field__input" id="message" name="message" rows="4" required></textarea>
            <span class="field__rule" aria-hidden="true"></span>
            <span class="field__error" data-error-for="message"></span>
          </div>

          <button type="submit" class="btn btn--primary self-start" data-magnetic="0.2">
            <span class="btn__label">Send brief</span>
            <span class="btn__fill" aria-hidden="true"></span>
          </button>

          <p class="contact-form__status" role="status" aria-live="polite" data-contact-status></p>
        </form>

        <aside class="contact__aside" data-reveal="rise">
          <div data-placeholder={contact.status}>
            <p class="contact__label">Email</p>
            <p class="contact__value">{contact.email}</p>

            <p class="contact__label mt-7">Phone</p>
            <p class="contact__value">{contact.phone}</p>

            <p class="contact__label mt-7">Working from</p>
            <p class="contact__value">{contact.locations}</p>
          </div>

          <div class="mt-10">
            <p class="contact__label">Disciplines</p>
            <ul class="contact__list">
              {services.items.map((s) => <li>{s.title}</li>)}
            </ul>
          </div>

          <ul class="mt-10 flex gap-2">
            {
              socials.map((s) => (
                <li>
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="contact__social"
                    data-magnetic="0.3"
                    aria-label={s.name}
                  >
                    <Icon name={s.icon} class="h-[18px] w-[18px]" />
                  </a>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact__title {
    font-size: var(--text-h1);
    font-weight: 800;
    margin-bottom: 3.5rem;
  }

  .contact__grid {
    display: grid;
    gap: 3.5rem;
  }
  @media (min-width: 1024px) {
    .contact__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.7fr);
      gap: 5rem;
    }
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    max-width: 34rem;
  }

  .field {
    position: relative;
  }

  .field__label {
    display: block;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    transition: color var(--duration-micro) var(--ease-soft);
  }
  .field:focus-within .field__label {
    color: var(--color-signal-deep);
  }

  .field__input {
    width: 100%;
    padding-block: 0.65rem;
    background: transparent;
    border: 0;
    border-radius: 0;
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.5;
    resize: vertical;
    outline: none;
  }
  .field__input:focus-visible {
    outline: none;
  }
  select.field__input {
    appearance: none;
    cursor: pointer;
  }

  .field__rule {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: var(--color-hairline);
  }
  .field__rule::after {
    content: '';
    position: absolute;
    inset: 0;
    height: 1.5px;
    border-radius: 2px;
    background: var(--gradient-brand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-layout) var(--ease-signature);
  }
  .field:focus-within .field__rule::after {
    transform: scaleX(1);
  }

  .field__error {
    display: block;
    margin-top: 0.5rem;
    min-height: 1.25rem;
    font-size: 0.875rem;
    color: var(--color-counter);
  }
  .field[data-invalid] .field__rule {
    background: var(--color-counter);
  }

  .contact-form__status {
    margin: 0;
    min-height: 1.5rem;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }
  .contact-form__status[data-state='error'] {
    color: var(--color-counter);
  }

  .contact__label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .contact__value {
    margin-top: 0.3rem;
    font-size: 1.0625rem;
  }

  .contact__list {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    line-height: 1.9;
    color: var(--color-muted);
  }

  .contact__social {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-hairline);
    border-radius: 999px;
    transition:
      background-color var(--duration-micro) var(--ease-soft),
      border-color var(--duration-micro) var(--ease-soft),
      color var(--duration-micro) var(--ease-soft);
  }
  .contact__social:hover,
  .contact__social:focus-visible {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .field__rule::after,
    .field__label,
    .contact__social {
      transition: none;
    }
  }

  @media (min-width: 1024px) {
    .contact__title,
    .contact__grid {
      margin-inline-start: var(--rail);
    }
  }
</style>

<script>
  // Validation and messaging only. Point `action` at a form backend before launch.
  function setupContact() {
    const form = document.querySelector<HTMLFormElement>('[data-contact]');
    const status = document.querySelector<HTMLElement>('[data-contact-status]');
    if (!form || !status) return;

    const messages: Record<string, string> = {
      name: 'Please tell us your name.',
      email: 'Please enter a valid email address.',
      message: 'Please tell us a little about the project.',
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let firstInvalid: HTMLElement | null = null;

      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]').forEach((el) => {
        const field = el.closest<HTMLElement>('.field');
        const error = form.querySelector<HTMLElement>(`[data-error-for="${el.name}"]`);
        const ok = el.checkValidity() && el.value.trim() !== '';

        field?.toggleAttribute('data-invalid', !ok);
        if (error) error.textContent = ok ? '' : (messages[el.name] ?? 'This field is required.');
        if (!ok && !firstInvalid) firstInvalid = el;
      });

      if (firstInvalid) {
        status.dataset.state = 'error';
        status.textContent = 'Please fix the highlighted fields.';
        (firstInvalid as HTMLElement).focus();
        return;
      }

      status.dataset.state = 'error';
      status.textContent = 'Form endpoint not configured yet.';
    });
  }

  document.addEventListener('astro:page-load', setupContact);
</script>
