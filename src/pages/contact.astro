---
/**
 * Contact. The header and footer CTAs point here, and the form is the one real
 * function the WordPress contact page had. Its copy was theme demo, so the
 * page is rewritten around the studio's actual disciplines.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import WallLabel from '../components/WallLabel.astro';
import Icon from '../components/Icon.astro';
import { contact, studio, services, socials } from '../content/site';
import { pages } from '../lib/seo';
import { web3formsKey, isDev } from '../lib/env';

/**
 * The form posts to Web3Forms, which relays it to the studio's inbox.
 *
 * `action` and `method` are real, not decorative: without JavaScript the
 * browser submits the form natively and Web3Forms renders its own confirmation
 * page. The script below intercepts it to keep the visitor on this page, so
 * the enhancement is the on-page success state, not the ability to send at all.
 *
 * With no key configured the action stays at `#` — the form then reports that
 * it is not wired up rather than posting into the void.
 */
const ENDPOINT = 'https://api.web3forms.com/submit';
const configured = web3formsKey.length > 0;
---

<BaseLayout seo={pages.contact}>
  <section class="section pt-[calc(var(--header-height)+4rem)]">
    <div class="shell">
      <WallLabel items={contact.label} />
      <h1 data-reveal="lines" class="contact__title display-title">
        {contact.titleLines.map((line) => <span data-line class="block">{line}</span>)}
      </h1>

      <div class="contact__grid">
        <form
          class="contact-form"
          method="POST"
          action={configured ? ENDPOINT : '#'}
          data-contact
          data-configured={configured ? '' : undefined}
          novalidate
        >
          <input type="hidden" name="access_key" value={web3formsKey} />

          {/* Web3Forms uses these to compose the message. `subject` is
              overwritten with the sender's name by the script; this value is
              what a no-JS submission arrives with. The field named `email` is
              what Web3Forms sets Reply-To from, so replying in the inbox
              answers the client directly. */}
          <input type="hidden" name="subject" value="New project brief — jpmediagroups.com" />
          <input type="hidden" name="from_name" value="JP Media Groups website" />

          {/* Honeypot. Web3Forms discards any submission where `botcheck` is
              ticked, and nothing but a bot filling every field it finds will
              ever tick it. Hidden from sight, from screen readers and from tab
              order — all three, or it becomes a trap for real people. */}
          <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            style="display:none"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <div class="field">
            <label class="field__label" for="name">Name</label>
            <input class="field__input" id="name" name="name" type="text" required autocomplete="name" />
            <span class="field__rule" aria-hidden="true"></span>
            <span class="field__error" data-error-for="name"></span>
          </div>

          <div class="field">
            <label class="field__label" for="email">Email</label>
            <input class="field__input" id="email" name="email" type="email" required autocomplete="email" />
            <span class="field__rule" aria-hidden="true"></span>
            <span class="field__error" data-error-for="email"></span>
          </div>

          <div class="field">
            <label class="field__label" for="discipline">What do you need?</label>
            <select class="field__input" id="discipline" name="discipline">
              {studio.disciplines.map((d) => <option value={d}>{d}</option>)}
              <option value="Not sure yet">Not sure yet</option>
            </select>
            <span class="field__rule" aria-hidden="true"></span>
          </div>

          <div class="field">
            <label class="field__label" for="message">Tell us about the project</label>
            <textarea class="field__input" id="message" name="message" rows="4" required></textarea>
            <span class="field__rule" aria-hidden="true"></span>
            <span class="field__error" data-error-for="message"></span>
          </div>

          <button type="submit" class="btn btn--primary self-start" data-magnetic="0.2" data-submit>
            <span class="btn__label" data-submit-label>Send brief</span>
            <span class="btn__fill" aria-hidden="true"></span>
          </button>

          {/* `role="status"` + `aria-live="polite"` so a screen reader hears the
              result without the focus being yanked out of the form. */}
          <p class="contact-form__status" role="status" aria-live="polite" data-contact-status></p>

          {
            isDev && !configured && (
              <p class="contact-form__setup">
                PENDIENTE — falta <code>PUBLIC_WEB3FORMS_KEY</code>. Copiá <code>.env.example</code>{' '}
                a <code>.env</code> y pegá la access key de web3forms.com. Este aviso no se
                renderiza en producción.
              </p>
            )
          }
        </form>

        <aside class="contact__aside" data-reveal="rise">
          <div data-placeholder={contact.status}>
            <p class="contact__label">Email</p>
            <p class="contact__value">{contact.email}</p>

            <p class="contact__label mt-7">Phone</p>
            <p class="contact__value">{contact.phone}</p>

            <p class="contact__label mt-7">Working from</p>
            <p class="contact__value">{contact.locations}</p>
          </div>

          <div class="mt-10">
            <p class="contact__label">Disciplines</p>
            <ul class="contact__list">
              {services.items.map((s) => <li>{s.title}</li>)}
            </ul>
          </div>

          <ul class="mt-10 flex gap-2">
            {
              socials.map((s) => (
                <li>
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="contact__social"
                    data-magnetic="0.3"
                    aria-label={s.name}
                  >
                    <Icon name={s.icon} class="h-[18px] w-[18px]" />
                  </a>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact__title {
    font-size: var(--text-h1);
    font-weight: 800;
    margin-bottom: 3.5rem;
  }

  .contact__grid {
    display: grid;
    gap: 3.5rem;
  }
  @media (min-width: 1024px) {
    .contact__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.7fr);
      gap: 5rem;
    }
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    max-width: 34rem;
  }

  .field {
    position: relative;
  }

  .field__label {
    display: block;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    transition: color var(--duration-micro) var(--ease-soft);
  }
  .field:focus-within .field__label {
    color: var(--color-signal-deep);
  }

  .field__input {
    width: 100%;
    padding-block: 0.65rem;
    background: transparent;
    border: 0;
    border-radius: 0;
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.5;
    resize: vertical;
    outline: none;
  }
  .field__input:focus-visible {
    outline: none;
  }
  select.field__input {
    appearance: none;
    cursor: pointer;
  }

  .field__rule {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: var(--color-hairline);
  }
  .field__rule::after {
    content: '';
    position: absolute;
    inset: 0;
    height: 1.5px;
    border-radius: 2px;
    background: var(--gradient-brand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-layout) var(--ease-signature);
  }
  .field:focus-within .field__rule::after {
    transform: scaleX(1);
  }

  .field__error {
    display: block;
    margin-top: 0.5rem;
    min-height: 1.25rem;
    font-size: 0.875rem;
    color: var(--color-counter);
  }
  .field[data-invalid] .field__rule {
    background: var(--color-counter);
  }

  .contact-form__status {
    margin: 0;
    min-height: 1.5rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-muted);
  }
  .contact-form__status[data-state='error'] {
    color: var(--color-counter);
  }
  /* Success reads in the identity green, and is the only place on the page
     where the gradient resolves to a single flat colour — it is a state, not
     a piece of the composition. */
  .contact-form__status[data-state='ok'] {
    color: var(--color-signal-deep);
    font-weight: 500;
  }

  /* The button carries the busy state; the status line just narrates it. */
  .contact-form button[disabled] {
    opacity: 0.55;
    cursor: progress;
  }

  /* Dev-only. Mirrors the `data-placeholder` badge used for pending copy. */
  .contact-form__setup {
    margin: 0;
    padding: 0.75rem 1rem;
    border: 1px dashed var(--color-counter);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.7;
    color: var(--color-counter);
  }
  .contact-form__setup code {
    font-family: inherit;
    font-weight: 700;
  }

  .contact__label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .contact__value {
    margin-top: 0.3rem;
    font-size: 1.0625rem;
  }

  .contact__list {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    line-height: 1.9;
    color: var(--color-muted);
  }

  .contact__social {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-hairline);
    border-radius: 999px;
    transition:
      background-color var(--duration-micro) var(--ease-soft),
      border-color var(--duration-micro) var(--ease-soft),
      color var(--duration-micro) var(--ease-soft);
  }
  .contact__social:hover,
  .contact__social:focus-visible {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .field__rule::after,
    .field__label,
    .contact__social {
      transition: none;
    }
  }

  @media (min-width: 1024px) {
    .contact__title,
    .contact__grid {
      margin-inline-start: var(--rail);
    }
  }
</style>

<script>
  /**
   * Submits the brief without leaving the page.
   *
   * The form already works without this: `action` and `method` are real, so a
   * browser with no JavaScript posts it natively and lands on Web3Forms' own
   * confirmation. Everything here is the enhancement — inline validation, an
   * on-page result, and a button that cannot be pressed twice.
   */
  function setupContact() {
    const form = document.querySelector<HTMLFormElement>('[data-contact]');
    const status = document.querySelector<HTMLElement>('[data-contact-status]');
    if (!form || !status) return;

    const button = form.querySelector<HTMLButtonElement>('[data-submit]');
    const label = form.querySelector<HTMLElement>('[data-submit-label]');
    const configured = form.hasAttribute('data-configured');
    const idle = label?.textContent ?? 'Send brief';

    const messages: Record<string, string> = {
      name: 'Please tell us your name.',
      email: 'Please enter a valid email address.',
      message: 'Please tell us a little about the project.',
    };

    const say = (state: 'error' | 'ok' | 'busy', text: string) => {
      status.dataset.state = state;
      status.textContent = text;
    };

    /**
     * Marks every required field and returns the first one that failed.
     *
     * A `const` arrow rather than a function declaration: a declaration is
     * hoisted above the null guard on `form`, so TypeScript stops trusting the
     * narrowing and flags every use inside as possibly null.
     */
    const validate = (): HTMLElement | null => {
      let firstInvalid: HTMLElement | null = null;

      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]').forEach((el) => {
        const field = el.closest<HTMLElement>('.field');
        const error = form.querySelector<HTMLElement>(`[data-error-for="${el.name}"]`);
        const ok = el.checkValidity() && el.value.trim() !== '';

        field?.toggleAttribute('data-invalid', !ok);
        if (error) error.textContent = ok ? '' : (messages[el.name] ?? 'This field is required.');
        if (!ok && !firstInvalid) firstInvalid = el;
      });

      return firstInvalid;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const firstInvalid = validate();
      if (firstInvalid) {
        say('error', 'Please fix the highlighted fields.');
        (firstInvalid as HTMLElement).focus();
        return;
      }

      if (!configured) {
        say('error', 'Form endpoint not configured yet.');
        return;
      }

      // Locked for the whole request so an impatient second click cannot send
      // the brief twice.
      const lock = (busy: boolean) => {
        if (button) button.disabled = busy;
        form.setAttribute('aria-busy', String(busy));
        if (label) label.textContent = busy ? 'Sending…' : idle;
      };

      lock(true);
      say('busy', 'Sending…');

      const data = new FormData(form);
      // A subject that names the sender, so the inbox is scannable instead of
      // forty identical rows.
      data.set('subject', `New project brief — ${String(data.get('name') ?? '').trim()}`);

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        const body = await res.json().catch(() => null);

        if (res.ok && body?.success) {
          form.reset();
          form
            .querySelectorAll<HTMLElement>('[data-invalid]')
            .forEach((f) => f.removeAttribute('data-invalid'));
          say('ok', 'Thank you — your brief is on its way. We usually reply within two business days.');
        } else {
          // The visitor is told to use the address they can see on this page,
          // rather than being left with a dead end.
          say('error', body?.message ?? 'Something went wrong. Please email us instead.');
        }
      } catch {
        say('error', 'No connection. Check your network, or email us instead.');
      } finally {
        lock(false);
      }
    });
  }

  document.addEventListener('astro:page-load', setupContact);
</script>
