---
/**
 * One portfolio category, in English — /work/bodas/, /work/food/ …
 *
 * The page itself lives in `components/WorkCategoryPage.astro`, because the
 * Spanish route at /es/trabajo/<categoria>/ renders exactly the same thing in
 * the other language. Two routes, one template: a fix to the gallery, the
 * lightbox or the schema lands on both, which is the only way a translated site
 * stays in sync past the first month.
 */
import WorkCategoryPage from "../../../components/WorkCategoryPage.astro";
import { workCategories } from "../../../content/site";

export function getStaticPaths() {
  return workCategories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
---

<WorkCategoryPage category={category} lang="en" />
