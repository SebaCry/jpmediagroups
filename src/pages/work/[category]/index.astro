---
/**
 * One portfolio category - /work/bodas/, /work/food/, /work/websites/ …
 *
 * Two layouts behind one route, chosen by `kind`:
 *
 *   photo / video - a masonry-ish column grid of stills, opening into a
 *                   lightbox. Photographs are the argument on these pages, so
 *                   they get the whole width and nothing competes with them.
 *   web           - cards with a live link, a year and a scope. A website is
 *                   proved by being visited, not by a screenshot of it.
 *
 * The photographs are discovered from src/assets/work/<slug>/ - see the README
 * in that folder. Nothing here lists a filename.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WallLabel from "../../../components/WallLabel.astro";
import Icon from "../../../components/Icon.astro";
import { Image } from "astro:assets";
import {
  workCategories,
  websites,
  contact,
  driveFolder,
} from "../../../content/site";
import { gallery, gallerySection, shot } from "../../../lib/images";
import { pages, abs } from "../../../lib/seo";
import { isDev } from "../../../lib/env";

export function getStaticPaths() {
  return workCategories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const photos = gallery(category.slug);
const isWeb = category.kind === "web";

/**
 * Chapters, for the categories that declare them (today: food).
 *
 * A chapter with nothing in its folder is dropped rather than rendered as an
 * empty heading — the same rule the flat gallery follows. If none survive, the
 * page falls back to the single grid every other category uses, so declaring
 * sections can never leave a category worse off than not declaring them.
 *
 * `start` is the offset of each chapter inside the page's single lightbox
 * sequence. Two grids, one viewer: a visitor who opens the last fine-dining
 * plate and keeps pressing → walks straight into the burgers, which is the
 * whole point of keeping one dialog for the page.
 */
let cursor = 0;
const chapters = (category.sections ?? [])
  .map((s) => ({ ...s, photos: gallerySection(category.slug, s.dir) }))
  .filter((c) => c.photos.length > 0)
  .map((c) => {
    const start = cursor;
    cursor += c.photos.length;
    return { ...c, start };
  });

const isSplit = !isWeb && chapters.length > 0;
/** How many frames the lightbox walks. Chapters may cover fewer than `photos`. */
const shownCount = isSplit ? cursor : photos.length;

// The schema needs absolute, post-build URLs. `Image` rewrites `src` at build
// time, so the optimised path is read off the metadata rather than guessed.
const seo = pages.workCategory(
  category,
  isWeb
    ? []
    : photos.map((p) => ({
        url: abs(p.image.src),
        caption: `${category.name} by JP Media Groups`,
      })),
);

const siblings = workCategories.filter((c) => c.slug !== category.slug);
const sites = websites.items.map((s) => ({ ...s, image: shot(s.slug) }));
---

<BaseLayout seo={seo}>
  <section class="section pt-[calc(var(--header-height)+4rem)] pb-0">
    <div class="shell">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/work/">Work</a></li>
          <li aria-current="page">{category.short}</li>
        </ol>
      </nav>

      {
        /* The count is only stated once there is something to count. An empty
          gallery says nothing about itself rather than announcing the gap. */
      }
      <WallLabel
        items={[
          category.short,
          category.discipline,
          ...(photos.length ? [`${photos.length} pieces`] : []),
        ]}
      />

      <h1 data-reveal="lines" class="cat-page__title display-title">
        <span data-line class="block">{category.name}</span>
      </h1>

      <div class="cat-page__intro">
        <p data-reveal="rise" class="lead cat-page__lead">{category.lead}</p>
        <div data-reveal="rise" class="cat-page__copy">
          {category.body.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  {
    /* --- Websites -------------------------------------------------------- */
    isWeb ? (
      <section class="section">
        <div class="shell">
          <ul class="sites" data-placeholder={websites.status}>
            {sites.map((s) => {
              const live = s.url.length > 0;
              const Tag = live ? "a" : "div";
              return (
                <li class="site" data-reveal="rise">
                  <Tag
                    class="site__link"
                    {...(live
                      ? {
                          href: s.url,
                          target: "_blank",
                          rel: "noopener noreferrer",
                        }
                      : {})}
                  >
                    <span class="site__frame">
                      {s.image ? (
                        <Image
                          src={s.image}
                          alt={`${s.name} - website built by JP Media Groups`}
                          widths={[520, 900, 1400]}
                          sizes="(min-width: 768px) 46vw, 92vw"
                          loading="lazy"
                          class="site__img"
                        />
                      ) : (
                        <span class="frame-empty site__empty">
                          <span>Screenshot</span>
                          {isDev && (
                            <span class="site__empty-note">
                              src/assets/work/websites/{s.slug}.jpg
                            </span>
                          )}
                        </span>
                      )}
                    </span>

                    <span class="site__body">
                      <span class="site__meta">
                        {s.year || "Year pending"}
                        <span class="wall-label__sep" aria-hidden="true">
                          {" "}
                          /{" "}
                        </span>
                        {s.scope.join(" · ")}
                      </span>
                      <span class="site__name">
                        {s.name}
                        {live && (
                          <Icon name="arrow-right" class="site__cue h-4 w-4" />
                        )}
                      </span>
                      <span class="site__url">
                        {live
                          ? s.url.replace(/^https?:\/\/(www\.)?/, "")
                          : "URL pending"}
                      </span>
                    </span>
                  </Tag>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    ) : isSplit ? (
      /* --- Photographs, in chapters --------------------------------------- */
      /* Two headed grids instead of one. Each chapter is its own <section> with
         its own <h2>, so the split is in the document outline rather than only
         in the spacing — a crawler and a screen reader both get told that a
         plated course and a burger are different work, which is the argument
         the client is making by asking for the split at all. */
      chapters.map((chapter, ci) => (
        <section class="section chapter" data-chapter={ci}>
          <div class="shell">
            <header class="chapter__head" data-reveal="rise">
              <p class="chapter__kicker">
                {chapter.kicker}
                <span class="wall-label__sep" aria-hidden="true">
                  {" "}
                  /{" "}
                </span>
                {chapter.photos.length} photographs
              </p>
              <h2 class="chapter__title">
                {chapter.title}
                <span class="chapter__title-alt">{chapter.titleAlt}</span>
              </h2>
              <p class="chapter__lead">{chapter.lead}</p>
            </header>
          </div>

          <div class="grid-wrap">
            <ul class="stills" data-lightbox-scope>
              {chapter.photos.map((p, i) => {
                /* One sequence across both grids, so the viewer can walk the
                   whole page from any thumbnail. */
                const n = chapter.start + i;
                return (
                  <li class="still">
                    <button
                      type="button"
                      class="still__btn"
                      data-lightbox={n}
                      aria-label={`Open image ${n + 1} of ${shownCount} — ${chapter.title}`}
                    >
                      <Image
                        src={p.image}
                        alt={`${chapter.title} — ${category.name} by JP Media Groups - ${i + 1}`}
                        widths={[400, 700, 1100, 1600]}
                        sizes="(min-width: 1280px) 30vw, (min-width: 768px) 45vw, 92vw"
                        loading={n < 3 ? "eager" : "lazy"}
                        fetchpriority={n === 0 ? "high" : "auto"}
                        class="still__img"
                      />
                    </button>
                  </li>
                );
              })}
            </ul>
          </div>
        </section>
      ))
    ) : photos.length ? (
      /* --- Photographs ---------------------------------------------------- */
      /* A column grid rather than a row grid: portraits and landscapes from the
         same shoot have different heights, and forcing them into a fixed ratio
         crops the composition out of every one of them. */
      <section class="section pt-14">
        <div class="grid-wrap">
          <ul class="stills" data-lightbox-scope>
            {photos.map((p, i) => (
              <li class="still">
                <button
                  type="button"
                  class="still__btn"
                  data-lightbox={i}
                  aria-label={`Open image ${i + 1} of ${photos.length}`}
                >
                  <Image
                    src={p.image}
                    alt={`${category.name} by JP Media Groups - ${i + 1}`}
                    widths={[400, 700, 1100, 1600]}
                    sizes="(min-width: 1280px) 30vw, (min-width: 768px) 45vw, 92vw"
                    loading={i < 3 ? "eager" : "lazy"}
                    fetchpriority={i === 0 ? "high" : "auto"}
                    class="still__img"
                  />
                </button>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ) : (
      /* --- Nothing loaded yet ---------------------------------------------
         Dev only. In production the page simply ends after the copy and runs
         into the contact block below, which reads as a finished service page
         rather than as a broken gallery - and a visitor is never shown a
         source path or told the site is unfinished. */
      isDev && (
        <section class="section">
          <div class="shell">
            <div class="awaiting" data-placeholder="pending">
              <p class="awaiting__title">No photographs loaded yet</p>
              <p class="awaiting__body">
                Drop the files from <strong>{category.source}</strong> into
                <code>src/assets/work/{category.slug}/</code> and they appear
                here automatically - there is no list to update. Name them{" "}
                <code>01.jpg</code>, <code>02.jpg</code> … to set the order.
              </p>
            </div>
          </div>
        </section>
      )
    )
  }

  {
    /* The rest of the shoot. The page carries a curated two dozen; the archive
       is hundreds of frames per category and belongs somewhere a visitor opts
       into, not in a scroll nobody finishes. */
    !isWeb && photos.length > 0 && (
      <section class="section pt-0">
        <div class="shell">
          <div class="more" data-reveal="rise">
            <div>
              <p class="more__label">The full gallery</p>
              <p class="more__title">
                {photos.length} shown here. The complete {category.name.toLowerCase()} archive
                lives on Drive.
              </p>
            </div>
            <a
              href={driveFolder}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--primary more__btn"
              data-magnetic="0.2"
            >
              <span class="btn__label">See the full portfolio</span>
              <span class="btn__fill" aria-hidden="true" />
            </a>
          </div>
        </div>
      </section>
    )
  }

  <section class="section pt-0">
    <div class="shell">
      <hr class="rule mb-10" />

      <div class="cat-page__foot">
        <div>
          <p class="cat-page__label">More work</p>
          <ul class="siblings">
            {
              siblings.map((c) => (
                <li>
                  <a href={`/work/${c.slug}/`} class="sibling">
                    {c.short}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <p class="cat-page__label">Start a project</p>
          <a href="/contact/" class="btn btn--primary mt-4" data-magnetic="0.2">
            <span class="btn__label">Tell us about it</span>
            <span class="btn__fill" aria-hidden="true"></span>
          </a>
          <p class="cat-page__contact">{contact.email}</p>
        </div>
      </div>
    </div>
  </section>

  {
    /* Lightbox. One dialog for the whole page, populated on open - cloning a
       full-size <img> per photograph would ship every original on page load. */
    photos.length > 0 && !isWeb && (
      <div class="lb" data-lightbox-root hidden>
        <div class="lb__backdrop" data-lightbox-close />
        <div
          class="lb__stage"
          role="dialog"
          aria-modal="true"
          aria-label={`${category.name}, image viewer`}
        >
          <img class="lb__img" data-lightbox-img alt="" />
          <p class="lb__count" data-lightbox-count aria-live="polite" />
          <button
            type="button"
            class="lb__btn lb__btn--prev"
            data-lightbox-prev
            aria-label="Previous image"
          >
            <Icon name="arrow-right" class="h-5 w-5" />
          </button>
          <button
            type="button"
            class="lb__btn lb__btn--next"
            data-lightbox-next
            aria-label="Next image"
          >
            <Icon name="arrow-right" class="h-5 w-5" />
          </button>
          <button
            type="button"
            class="lb__btn lb__btn--close"
            data-lightbox-close
            aria-label="Close"
          >
            <Icon name="close" class="h-5 w-5" />
          </button>
        </div>
      </div>
    )
  }
</BaseLayout>

<style>
  .crumbs {
    margin-bottom: 1.75rem;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .crumbs li + li::before {
    content: "/";
    margin-right: 0.5rem;
    color: var(--color-hairline);
  }

  .cat-page__title {
    font-size: var(--text-h1);
    font-weight: 800;
    line-height: 0.98;
  }

  .cat-page__intro {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
  }
  @media (min-width: 1024px) {
    .cat-page__intro {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 4rem;
      align-items: start;
    }
  }
  .cat-page__lead {
    max-width: 40ch;
  }
  .cat-page__copy p {
    max-width: 62ch;
    line-height: 1.75;
    color: var(--color-muted);
  }
  .cat-page__copy p + p {
    margin-top: 1.25rem;
  }

  /* --- Chapters ----------------------------------------------------------
     Structural only for now: what separates the two halves of the gallery and
     what the heading of each one is. The editorial treatment - the full-bleed
     hero, the dark band between the chapters, the hover captions - is a
     separate pass and does not live here yet. */

  .chapter {
    padding-block: clamp(2.5rem, 4.5vw, 4.5rem);
  }

  .chapter__head {
    max-width: 62ch;
  }

  .chapter__kicker {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .chapter__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.9rem;
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    letter-spacing: var(--text-h2--letter-spacing);
    font-weight: 800;
  }

  /* The Spanish name is not a translation bolted on - both markets are real,
     and a Utah kitchen run by a Colombian chef is read by both. Kept smaller so
     it reads as a subtitle rather than competing with the English. */
  .chapter__title-alt {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .chapter__lead {
    margin-top: 1rem;
    max-width: 52ch;
    line-height: 1.7;
    color: var(--color-muted);
  }

  /* --- Stills ----------------------------------------------------------- */

  .grid-wrap {
    padding-inline: var(--spacing-gutter);
  }

  /* CSS columns, not grid: this is a masonry flow, and `columns` is the only
     thing that packs mixed-height photographs without leaving holes. Reading
     order runs down each column, which is what a contact sheet does anyway. */
  .stills {
    margin: 0 auto;
    padding: 0;
    max-width: var(--container-shell);
    list-style: none;
    columns: 1;
    column-gap: 14px;
  }
  @media (min-width: 768px) {
    .stills {
      columns: 2;
    }
  }
  @media (min-width: 1280px) {
    .stills {
      columns: 3;
    }
  }

  .still {
    /* Without this a photograph can be split across a column break. */
    break-inside: avoid;
    margin-bottom: 14px;
  }

  .still__btn {
    display: block;
    width: 100%;
    cursor: zoom-in;
    background: var(--color-chalk);
    overflow: hidden;
  }

  .still__img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform var(--duration-media) var(--ease-signature);
  }
  .still__btn:hover .still__img,
  .still__btn:focus-visible .still__img {
    transform: scale(1.03);
  }

  /* --- Websites --------------------------------------------------------- */

  .sites {
    display: grid;
    gap: 3rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 768px) {
    .sites {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .site__link {
    display: block;
    color: inherit;
  }

  .site__frame {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-chalk);
    border: 1px solid var(--color-hairline);
  }
  .site__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 1.6s var(--ease-signature);
  }
  /* A website scrolls, so its card does too - the screenshot pans down on
     hover instead of merely zooming. */
  a.site__link:hover .site__img,
  a.site__link:focus-visible .site__img {
    object-position: bottom center;
  }

  .site__empty {
    width: 100%;
    height: 100%;
    flex-direction: column;
    gap: 0.5rem;
    text-align: center;
  }
  .site__empty-note {
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--color-hairline);
    text-transform: none;
  }

  .site__body {
    display: block;
    padding-top: 1rem;
  }
  .site__meta {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .site__name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  a.site__link:hover .site__name {
    color: var(--color-signal-deep);
  }
  .site__cue {
    flex: none;
    transition: transform var(--duration-micro) var(--ease-signature);
  }
  a.site__link:hover .site__cue {
    transform: translateX(5px);
  }
  .site__url {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  /* --- Nothing loaded --------------------------------------------------- */

  .awaiting {
    padding: 2.5rem;
    border: 1px dashed var(--color-hairline);
    text-align: center;
  }
  .awaiting__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
  }
  .awaiting__body {
    margin: 0.75rem auto 0;
    max-width: 56ch;
    line-height: 1.7;
    color: var(--color-muted);
  }
  .awaiting code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--color-signal-deep);
  }

  /* --- The rest of the archive ------------------------------------------ */

  .more {
    display: grid;
    gap: 1.75rem;
    padding: 2.25rem;
    background: var(--color-chalk);
    border: 1px solid var(--color-hairline);
  }
  @media (min-width: 768px) {
    .more {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 3rem;
      padding: 2.5rem 3rem;
    }
  }

  .more__label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .more__title {
    margin-top: 0.5rem;
    max-width: 46ch;
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .more__btn {
    justify-self: start;
  }

  /* --- Foot ------------------------------------------------------------- */

  .cat-page__foot {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 768px) {
    .cat-page__foot {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: 4rem;
    }
  }

  .cat-page__label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .siblings {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .sibling {
    display: inline-block;
    padding: 0.55rem 1rem;
    border: 1px solid var(--color-hairline);
    border-radius: 999px;
    font-size: 0.9375rem;
    transition:
      background-color var(--duration-micro) var(--ease-soft),
      border-color var(--duration-micro) var(--ease-soft),
      color var(--duration-micro) var(--ease-soft);
  }
  .sibling:hover,
  .sibling:focus-visible {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: #fff;
  }

  .cat-page__contact {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  /* --- Lightbox --------------------------------------------------------- */

  .lb {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
  }
  .lb[hidden] {
    display: none;
  }
  .lb__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 21, 25, 0.94);
    cursor: zoom-out;
  }
  /* `inset: 0`, not `width/height: 100%`.
     As a grid item of `.lb`, the stage's `height: 100%` had nothing definite to
     resolve against, so it grew to fit its content instead of filling the
     viewport. `max-height: 100%` on the photograph then resolved against that
     content-driven height - circular, so it did nothing, and a portrait frame
     stretched the stage to 2096px inside a 900px window. The buttons centre
     inside the stage, so they landed 126px below the fold and could not be
     clicked at all. Absolute positioning gives the stage a definite box, which
     is what every percentage inside it needs. */
  .lb__stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 5vw, 4rem);
  }
  .lb__img {
    max-width: 100%;
    max-height: 100%;
    /* Grid items default to `min-height: auto`, which refuses to shrink below
       the image's intrinsic height and would undo the max-height above. */
    min-width: 0;
    min-height: 0;
    object-fit: contain;
  }
  .lb__count {
    position: absolute;
    bottom: clamp(0.75rem, 3vw, 1.75rem);
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.14em;
    color: #8ba3a8;
  }

  .lb__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-hairline-dark);
    border-radius: 999px;
    color: #fff;
    background: rgba(18, 35, 43, 0.6);
    cursor: pointer;
    transition:
      background-color var(--duration-micro) var(--ease-soft),
      color var(--duration-micro) var(--ease-soft);
  }
  .lb__btn:hover,
  .lb__btn:focus-visible {
    background: var(--color-verde);
    color: var(--color-ink);
  }
  /* Vertically centred with `inset-block: 0; margin-block: auto` rather than
     `top: 50%` + a translate, because `--prev` already spends its transform on
     the 180° flip and the two would fight.
     Setting only `left`/`right` was a real bug: with no vertical offset the
     buttons fell back to their static position, which inside a `place-items:
     center` grid is a row of their own BELOW the image - 126px past the bottom
     of the viewport, unreachable. */
  .lb__btn--prev,
  .lb__btn--next {
    top: 0;
    bottom: 0;
    margin-block: auto;
  }
  .lb__btn--prev {
    left: clamp(0.5rem, 2vw, 1.5rem);
    transform: rotate(180deg);
  }
  .lb__btn--next {
    right: clamp(0.5rem, 2vw, 1.5rem);
  }
  .lb__btn--close {
    top: clamp(0.5rem, 2vw, 1.5rem);
    right: clamp(0.5rem, 2vw, 1.5rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .still__img,
    .site__img,
    .site__cue,
    .sibling,
    .lb__btn {
      transition: none;
    }
  }

  @media (min-width: 1024px) {
    .crumbs,
    .cat-page__title,
    .cat-page__intro,
    .chapter__head,
    :global(.section) > .shell > .wall-label {
      margin-inline-start: var(--rail);
    }
  }
</style>

<script>
  /**
   * The gallery lightbox.
   *
   * Sources are read off the thumbnails already in the page - Astro has
   * generated a full srcset for each, so the viewer gets the largest candidate
   * the browser would have picked, without a second set of imports.
   *
   * Everything degrades: with no JavaScript the thumbnails are simply buttons
   * that do nothing, and the photographs are all still on the page at full
   * responsive width.
   */
  function setupLightbox() {
    const root = document.querySelector<HTMLElement>("[data-lightbox-root]");
    const scopes = Array.from(
      document.querySelectorAll<HTMLElement>("[data-lightbox-scope]"),
    );
    if (!root || !scopes.length) return;

    const img = root.querySelector<HTMLImageElement>("[data-lightbox-img]");
    const count = root.querySelector<HTMLElement>("[data-lightbox-count]");

    // Every grid on the page, as ONE sequence. A split category renders two
    // scopes, and querying only the first left the second grid's thumbnails
    // opening nothing at all. Sorted by the index the page stamped on them
    // rather than by DOM order, so the two never disagree about what "next" is.
    const triggers = scopes
      .flatMap((s) =>
        Array.from(s.querySelectorAll<HTMLButtonElement>("[data-lightbox]")),
      )
      .sort(
        (a, b) =>
          Number(a.dataset.lightbox ?? 0) - Number(b.dataset.lightbox ?? 0),
      );
    if (!img || !triggers.length) return;

    let index = 0;
    let opener: HTMLElement | null = null;

    /** Largest candidate in the thumbnail's srcset, falling back to its src. */
    const sourceFor = (i: number) => {
      const thumb = triggers[i]?.querySelector("img");
      if (!thumb) return "";
      const best = (thumb.getAttribute("srcset") ?? "")
        .split(",")
        .map((part) => {
          const [url, w] = part.trim().split(/\s+/);
          return { url, w: parseInt(w ?? "0", 10) };
        })
        .filter((c) => c.url)
        .sort((a, b) => b.w - a.w)[0];
      return best?.url ?? thumb.src;
    };

    const show = (i: number) => {
      index = (i + triggers.length) % triggers.length;
      img.src = sourceFor(index);
      img.alt = triggers[index].querySelector("img")?.alt ?? "";
      if (count) count.textContent = `${index + 1} / ${triggers.length}`;
    };

    const open = (i: number, from: HTMLElement) => {
      opener = from;
      show(i);
      root.hidden = false;

      // Two locks, because they stop two different things.
      //
      // `overflow: hidden` stops the native scroll, which is what traps the
      // gesture on iOS. It does NOT stop Lenis: smooth scrolling runs its own
      // RAF loop and keeps driving the page from whatever momentum was left
      // when the viewer opened, so the overlay's own buttons drift under the
      // pointer for a second or two. The site already has a convention for
      // this - the search overlay uses it - so the lightbox joins it rather
      // than importing the motion module.
      document.body.style.overflow = "hidden";
      document.dispatchEvent(new CustomEvent("overlay:open"));

      root.querySelector<HTMLElement>("[data-lightbox-next]")?.focus();
    };

    const close = () => {
      root.hidden = true;
      document.body.style.overflow = "";
      document.dispatchEvent(new CustomEvent("overlay:close"));
      // Focus goes back where it came from, or the viewer leaves a keyboard
      // user at the top of the document with no idea where they were.
      opener?.focus();
      opener = null;
    };

    triggers.forEach((t, i) => t.addEventListener("click", () => open(i, t)));
    root
      .querySelectorAll("[data-lightbox-close]")
      .forEach((el) => el.addEventListener("click", close));
    root
      .querySelector("[data-lightbox-prev]")
      ?.addEventListener("click", () => show(index - 1));
    root
      .querySelector("[data-lightbox-next]")
      ?.addEventListener("click", () => show(index + 1));

    document.addEventListener("keydown", (e) => {
      if (root.hidden) return;
      if (e.key === "Escape") close();
      if (e.key === "ArrowLeft") show(index - 1);
      if (e.key === "ArrowRight") show(index + 1);
    });

    // View Transitions swap the DOM without a reload; a lock left on <body>
    // would survive into the next page and freeze it.
    document.addEventListener("astro:before-swap", () => {
      document.body.style.overflow = "";
      document.dispatchEvent(new CustomEvent("overlay:close"));
    });
  }

  document.addEventListener("astro:page-load", setupLightbox);
</script>
