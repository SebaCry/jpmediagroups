{
  "name": "jp-media-groups",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "JP Media Groups - Utah marketing agency & professional photography. Astro migration of the WordPress landing.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "assets": "node scripts/generate-assets.mjs",
    "og": "node scripts/generate-og.mjs",
    "check:seo": "node scripts/seocheck.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "shots": "node scripts/shoot.mjs --out shots",
    "shots:mobile": "node scripts/shoot.mjs --mobile --out shots",
    "measure": "node scripts/measure.mjs",
    "check:nav": "node scripts/navcheck.mjs",
    "check:flash": "node scripts/flashcheck.mjs",
    "check:dev": "node scripts/devcheck.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^4.1.0",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^5.14.1",
    "gsap": "^3.13.0",
    "lenis": "^1.3.11",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.1.14",
    "pagefind": "^1.4.0",
    "playwright": "^1.62.1",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
